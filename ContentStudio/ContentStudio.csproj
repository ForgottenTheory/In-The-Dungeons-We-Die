<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- The repo ships only the .NET 10 SDK; everything targets net8.0 and rolls forward. -->
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ContentStudio</AssemblyName>
    <RootNamespace>ContentStudio</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- One-way dependency: Content Studio reads the game's domain; the game never knows this tool exists. -->
    <ProjectReference Include="..\core\InTheDungeonsWeDie.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The nested test project compiles itself; keep it out of the app's own globs. -->
    <Compile Remove="Tests/**" />
    <Content Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>

</Project>
