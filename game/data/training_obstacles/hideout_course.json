[
  // The Hideout training course. Five slots, one obstacle each; running a lap grants Agility
  // XP, and the obstacles you chose to fit grant their bonus for as long as they stay fitted.
  //
  // That second half is the reason the course is configurable at all. Fitting the climbing wall
  // instead of the endurance run is choosing faster Realm travel over safer hazards — a
  // decision made once and lived with, which is a different shape from the moment-to-moment
  // Discover → Pursue decision the gathering professions make (docs/professions.md §18).
  //
  // Bonus keys are validated against CourseBonusKeys, so a typo fails content validation
  // rather than silently granting nothing.

  // --- Balance ---------------------------------------------------------------------------
  {
    "id": "obstacle.beam_walk",
    "name": "Beam Walk",
    "slot": "Balance",
    "requiredLevel": 1,
    "intervalTicks": 90,
    "experience": 12,
    "description": "A plank over nothing much. Everyone starts here.",
    "bonuses": { "course.realm_travel_speed": 0.03 }
  },
  {
    "id": "obstacle.rope_bridge",
    "name": "Swaying Rope Bridge",
    "slot": "Balance",
    "requiredLevel": 20,
    "intervalTicks": 120,
    "experience": 30,
    "description": "It moves when you do. Teaches you to stop fighting it.",
    "bonuses": { "course.realm_travel_speed": 0.06, "course.hazard_avoidance": 0.02 }
  },
  {
    "id": "obstacle.spinning_log",
    "name": "Spinning Log",
    "slot": "Balance",
    "requiredLevel": 45,
    "intervalTicks": 160,
    "experience": 68,
    "description": "Rolls under load. The one obstacle nobody clears on their first month.",
    "bonuses": { "course.realm_travel_speed": 0.10, "course.hazard_avoidance": 0.04 }
  },

