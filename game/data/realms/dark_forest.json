{
  // ── THE DARK FOREST — the reference Realm ───────────────────────────────────────────────────
  //
  // Every other realm in the roster is a name and a walkable graph. This one is the proof that
  // the architecture makes a place worth being in, and future realms should be content additions
  // against these same node kinds rather than another architecture pass.
  //
  // ── THE SHAPE, AND WHY ──────────────────────────────────────────────────────────────────────
  //
  // Three depths, and each one asks the extraction question in a harder form:
  //
  //   Depth 1  safe-ish. TWO ways out (the forest edge and the descent), so leaving is a real
  //            choice and not just "the run ended". Teaches the map.
  //   Depth 2  the wall. An ELITE, a merchant that only takes coin you have not banked yet, a
  //            shrine, and a hazard between you and the good ground. Extraction is one node,
  //            and it is not next to the descent.
  //   Depth 3  the payoff. A BOSS, the two richest gathering nodes in the game, and an
  //            extraction you have to walk back to past everything that nearly killed you.
  //
  // ── WHAT REALM KNOWLEDGE CHANGES ────────────────────────────────────────────────────────────
  //
  // Three nodes here are `hidden` and simply do not exist for a party that has not learned the
  // routes (RealmInsight.HiddenRoutes). They are not bonuses bolted on — they are the shortcut
  // past the depth-2 hazard, the cache at depth 1, and the back way to the boss. The twentieth
  // run walks a different map from the first, which is the whole point.
  //
  // The ladder, in order: enemy weaknesses read first, then hazards become visible instead of
  // ambushing, then the rich workings are told from the poor, then the hidden nodes, and last
  // the exits. The THRESHOLDS live in RealmKnowledgeLevels.Required and have been retuned once
  // already (D38) — do not restate them here, or this comment starts lying the next time they
  // move. The Realm Preparation screen reads the same ladder before you commit to a run.

  "id": "realm.dark_forest",
  "name": "The Dark Forest",
  "supportedTiers": [1, 2],
  "tags": ["forest", "fey", "toxin"],
  "locations": [

    // ══ DEPTH 1 — learn the place ═════════════════════════════════════════════════════════════
    {
      "id": "loc.entrance", "name": "Camp Entrance", "type": "Entrance", "depth": 1,
      "connections": ["loc.forest_path"]
    },
    {
      "id": "loc.forest_path", "name": "Forest Path", "type": "Travel", "depth": 1,
      "connections": ["loc.entrance", "loc.old_grove", "loc.goblin_camp", "loc.iron_vein", "loc.forest_edge", "loc.hunters_camp"]
    },
    {
      // The first way out, one step from the entrance. Cheap to reach on purpose: extraction
      // should be a decision you keep making, not a thing that happens to you at the end.
      "id": "loc.forest_edge", "name": "The Forest Edge", "type": "Extraction", "depth": 1,
      "connections": ["loc.forest_path"]
    },
    {
      "id": "loc.hunters_camp", "name": "Hunter's Camp", "type": "Camp", "depth": 1,
      "connections": ["loc.forest_path", "loc.thornwall"],
      "restore_fraction": 0.5,
      "eventText": "Cold ashes, a stripped bedroll, and enough shelter to close your eyes for an hour."
    },
    {
      "id": "loc.old_grove", "name": "Old Grove", "type": "Gather", "depth": 1,
      "connections": ["loc.forest_path", "loc.ruins"],
      "professionActionId": "action.chop_oak",
      "loot_table": "loot.node.old_grove"
    },
    {
      // Mining, level 1 — the design brief's worked example, reachable on a first run.
      "id": "loc.iron_vein", "name": "Iron Vein", "type": "Gather", "depth": 1,
      "connections": ["loc.forest_path", "loc.ruins"],
      "professionActionId": "action.mine_iron",
      "loot_table": "loot.node.iron_vein"
    },
    {
      "id": "loc.goblin_camp", "name": "Goblin Camp", "type": "Combat", "depth": 1,
      "connections": ["loc.forest_path", "loc.ruins", "loc.wagon_wreck"],
      "actorId": "actor.goblin_raider"
    },
    {
      // Salvaging 5 — a deliberate profession gate on a Realm node. A fresh character can see
      // it and cannot work it, which is the interlock the design wants between the two halves.
      "id": "loc.wagon_wreck", "name": "Overturned Wagon", "type": "Gather", "depth": 1,
      "connections": ["loc.goblin_camp", "loc.descent"],
      "professionActionId": "action.search_wagon_wreck",
      "loot_table": "loot.node.wagon_wreck"
    },
    {
      "id": "loc.thornwall", "name": "The Thornwall", "type": "Hazard", "depth": 1,
      "connections": ["loc.hunters_camp", "loc.poachers_cache"],
      "hazard_damage": 6,
      "eventText": "Blackthorn grown across the deer path, waist high and hooked. You can push through it. It will cost you."
    },
    {
      // HIDDEN. The reward for learning the forest: the poachers' cache is the best thing at
      // depth 1 and sits behind a hazard nobody would push through without a reason.
      "id": "loc.poachers_cache", "name": "Poacher's Cache", "type": "Event", "depth": 1,
      "hidden": true,
      "connections": ["loc.thornwall"],
      "eventText": "Under the flat stone, exactly where the scratched mark on the elm said it would be.",
      "loot_table": "loot.node.poachers_cache"
    },
    {
      "id": "loc.ruins", "name": "Crumbling Ruins", "type": "Event", "depth": 1,
      "connections": ["loc.old_grove", "loc.goblin_camp", "loc.iron_vein", "loc.descent"],
      "eventText": "You pry open a moss-covered chest hidden in the ruins.",
      "loot_table": "loot.event.crumbling_ruins"
    },
    {
      "id": "loc.descent", "name": "The Descent", "type": "Descent", "depth": 1,
      "connections": ["loc.ruins", "loc.wagon_wreck"]
    },

    // ══ DEPTH 2 — the wall ════════════════════════════════════════════════════════════════════
    {
      "id": "loc.deep_path", "name": "Deep Path", "type": "Entrance", "depth": 2,
