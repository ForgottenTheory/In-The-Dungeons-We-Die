  { "id": "profession.yield.mult",    "name": "Profession Yield",      "kind": "multiplicative", "family": "profession", "min": 0 },
  { "id": "profession.preserve.chance", "name": "Resource Preservation", "kind": "additive",     "family": "profession", "min": 0, "max": 0.8 },
  { "id": "profession.double.chance", "name": "Double Output Chance",  "kind": "additive",       "family": "profession", "min": 0, "max": 1 },
  { "id": "profession.xp.mult",       "name": "Profession XP",         "kind": "multiplicative", "family": "profession", "min": 0 },
  { "id": "profession.mastery.mult",  "name": "Mastery XP",            "kind": "multiplicative", "family": "profession", "min": 0 },

  // --- Crafting ---------------------------------------------------------------------------
  { "id": "craft.quality",              "name": "Craft Quality",   "kind": "additive",       "family": "craft", "min": 0, "max": 1 },
  { "id": "craft.integrity_cost.mult",  "name": "Integrity Cost",  "kind": "multiplicative", "family": "craft", "min": 0, "lower_is_better": true },
  { "id": "craft.discovery.chance",     "name": "Discovery Chance","kind": "additive",       "family": "craft", "min": 0, "max": 1 },

  // --- Realm / loot -------------------------------------------------------------------------
