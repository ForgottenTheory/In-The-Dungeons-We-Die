[
  // Reusable brains (M2′c): weighted rules over the shared condition vocabulary, matching
  // moves by id or by TAG — the tag form is what lets one brain serve many bodies. AI chooses
  // intent only; the tick/action lifecycle resolves timing exactly as before.

  // Pressure → punish: open (and re-open) the target, then lean on attacks while it's open.
  {
    "id": "ai.skirmisher", "name": "Skirmisher Brain",
    "avoid_repeat_weight": 0.5,
    "rules": [
      { "move": "move.expose_weakness", "weight": 10,
        "when": [ { "kind": "targetHasStatus", "text": "status.vulnerable", "negate": true } ] },
      { "moveTag": "action:attack", "weight": 4 },
      { "moveTag": "action:attack", "weight": 6,
        "when": [ { "kind": "targetHasStatus", "text": "status.vulnerable" } ] }
    ]
  },

  // The "answer this telegraph" brain: heavy hits by default, the stagger threat weighted up,
  // and a defensive turtle when hurt.
  {
    "id": "ai.brute", "name": "Brute Brain",
    "avoid_repeat_weight": 0.4,
    "rules": [
      { "moveTag": "action:attack", "weight": 3 },
      { "moveTag": "mech:stagger", "weight": 5 },
      { "move": "move.brace", "weight": 10,
        "when": [ { "kind": "selfHealthBelow", "value": 0.4 } ] }
    ]
  },

  // DoT/debuff upkeep: keep poison and weaken applied, fill with cheap darts, poke in melee
  // only when the mana is gone.
  {
    "id": "ai.caster", "name": "Caster Brain",
    "avoid_repeat_weight": 0.5,
    "rules": [
      { "move": "move.venom_bolt", "weight": 8,
        "when": [ { "kind": "targetHasStatus", "text": "status.poison", "negate": true } ] },
      { "move": "move.wither", "weight": 8,
        "when": [ { "kind": "targetHasStatus", "text": "status.weaken", "negate": true } ] },
      { "moveTag": "action:spell", "weight": 3 },
      { "moveTag": "action:attack", "weight": 1 }
    ]
  },

  // ---- Added with the enemy-breadth pass ----------------------------------------------------
  //
  // These lean on the validator rule that a resolved brain must be able to select from the
  // actor's own moves. Weighting a tag here makes carrying that kind of move MANDATORY for
  // every actor in the role — "an archer has a ranged attack" becomes a build error instead of
  // a thing someone notices three fights later.

  // Stay at range; close only because there is nothing else left to do.
  {
    "id": "ai.archer", "name": "Archer Brain",
    "avoid_repeat_weight": 0.6,
    "rules": [
      { "moveTag": "delivery:ranged", "weight": 8 },
      { "moveTag": "action:attack", "weight": 2 }
    ]
  },

  // Patient, then not. Identical to the skirmisher in what it does and opposite in when: the
  // stalker does not create the opening, it waits for one and then commits everything.
  {
    "id": "ai.stalker", "name": "Stalker Brain",
    "avoid_repeat_weight": 0.3,
    "rules": [
      { "moveTag": "action:attack", "weight": 3 },
      { "moveTag": "action:attack", "weight": 9,
        "when": [ { "kind": "targetHasStatus", "text": "status.vulnerable" } ] }
    ]
  },

  // Turtles at half health rather than at the brink — the difference between a wall and a big
  // body, expressed as a threshold instead of a stat.
  {
    "id": "ai.guardian", "name": "Guardian Brain",
    "avoid_repeat_weight": 0.5,
    "rules": [
      { "moveTag": "action:attack", "weight": 3 },
      { "moveTag": "action:defensive", "weight": 9,
        "when": [ { "kind": "selfHealthBelow", "value": 0.5 } ] }
    ]
  },

  // No soft side and no favourite trick: presses with everything, and reaches for the
  // fight-ending tools whenever they are up.
  {
    "id": "ai.champion", "name": "Champion Brain",
    "avoid_repeat_weight": 0.35,
    "rules": [
      { "moveTag": "action:attack", "weight": 4 },
      { "moveTag": "mech:stagger", "weight": 6 },
      { "moveTag": "mech:impairment", "weight": 5 }
    ]
  }
]
