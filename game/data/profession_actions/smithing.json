    "requiredLevel": 1,
    "baseIntervalTicks": 120,
    "experience": 14,
    "inputs": [ { "itemId": "material.copper_ore", "quantity": 2 } ],
    "outputs": [ { "itemId": "material.copper_ingot", "quantity": 1 } ]
  },
