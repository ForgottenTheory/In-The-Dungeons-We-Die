[
  // Thieving. Melvor-style target selection: each mark has a level requirement, an interval, a
  // success chance and its own common/unique table. This is the second profession with a
  // `successChance` below 1 — the mark notices — and it drops fastest as the marks get better.
  //
  // No currency is invented here. There is no economy yet, and a coin item that nothing spends
  // would be exactly the fake profession-specific resource the design forbids. What a thief
  // actually walks off with is precious metal, gems, a key, or somebody's paperwork — all of
  // which already exist and all of which other professions consume.
  {
    "id": "action.pickpocket_drunk_mercenary",
    "professionId": "profession.thieving",
    "name": "Pickpocket a Drunk Mercenary",
    "requiredLevel": 1,
    "baseIntervalTicks": 100,
    "experience": 12,
    "successChance": 0.8,
    "outputs": [ { "itemId": "material.native_copper", "quantity": 1 } ],
    "bonusOutputs": [ { "itemId": "material.iron_key", "chance": 0.08, "quantity": 1 } ]
  },
  {
