[
  // Assay pays in comprehension, never in power. Its level drives AssayLens, which decides how
  // much of a material's reading is legible — at level 1 you get "Hot Metal" and four lines of
  // ???, and by 85 you are reading essence load and potential. The underlying reading is
  // computed identically at every level; Assay only removes redaction (docs/professions.md §20).
  //
  // Its material output is the property dossier, and the reason that is not a dead-end trophy
  // is that the three deepest crafting actions in the game require one: Alchemy's
  // transmutation, Runecrafting's resonance catalyst and Artifice's clockwork core. You cannot
  // do the hard work on a compound you have not bothered to understand.
  {
    "id": "action.take_reference_sample",
    "professionId": "profession.assay",
    "name": "Take a Reference Sample",
    "requiredLevel": 1,
    "baseIntervalTicks": 100,
    "experience": 11,
    "inputs": [ { "itemId": "material.granite", "quantity": 1 } ],
    "outputs": [ { "itemId": "material.reference_sample", "quantity": 2 } ]
  },
  {
    "id": "action.assay_mineral_sample",
    "professionId": "profession.assay",
    "name": "Assay a Mineral Sample",
    "requiredLevel": 5,
    "baseIntervalTicks": 140,
    "experience": 18,
    "inputs": [
      { "itemId": "material.iron_ore", "quantity": 1 },
      { "itemId": "material.reference_sample", "quantity": 1 }
    ],
    "outputs": [ { "itemId": "material.property_dossier", "quantity": 1 } ]
  },
  {
