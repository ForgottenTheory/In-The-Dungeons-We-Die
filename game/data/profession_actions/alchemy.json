[
  // Alchemy transforms. Where Herblore hands you a drier version of what you gave it, Alchemy
  // hands back something none of the inputs were — a solvent, a catalyst, iron out of bog mud.
  //
  // These are the *stable known chains* only: the deliberate work (substrate + reagents +
  // catalyst + process, previewed before commit) is the material transformation engine at the
  // bench, and Alchemy level is what gates its processes. Nothing here duplicates the algebra.
  {
    // Alchemy's ground floor. Grind Herb Powder used to sit here; it moved to Herblore in the
    // 20-profession pass, because grinding a leaf is preparation, not transformation. Leaching
    // lye out of ash is the opposite — nothing that went in was caustic — and it gives lye a
    // source, which it did not have before.
    "id": "action.leach_lye",
    "professionId": "profession.alchemy",
    "name": "Leach Lye",
    "requiredLevel": 1,
    "baseIntervalTicks": 110,
    "experience": 11,
    "inputs": [
      { "itemId": "material.wood_ash", "quantity": 2 },
      { "itemId": "material.rainwater", "quantity": 1 }
    ],
    "outputs": [ { "itemId": "material.lye", "quantity": 1 } ]
  },
