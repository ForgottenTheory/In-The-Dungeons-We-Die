[
  // Artifice is the profession that makes the other professions work. Its outputs are not gear:
  // they are glass, parchment, mortar, lenses and mechanisms — the things Cartography writes
  // on, Assay looks through, Salvaging's wreckage becomes again, and fabrication bolts in.
  //
  // Note the loop the design asks for is already closed twice over: Mining and Forestry feed
  // Smithing's tool head and Artifice's haft; Salvaging's broken mechanisms come back as
  // working ones. The two *worn* tool slots that consume a finished tool are E6 — the
  // components exist now, deliberately ahead of the slots.
  {
    "id": "action.shape_tool_haft",
    "professionId": "profession.artifice",
    "name": "Shape a Tool Haft",
    "requiredLevel": 1,
    "baseIntervalTicks": 100,
    "experience": 11,
    "inputs": [ { "itemId": "material.oak_plank", "quantity": 1 } ],
    "outputs": [ { "itemId": "material.tool_haft", "quantity": 2 } ]
  },
