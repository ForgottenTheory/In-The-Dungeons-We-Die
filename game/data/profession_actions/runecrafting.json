[
  // Runecrafting. One rune per essence in essences/essences.json, and each rune's properties
  // sit on that essence's anchor property — so a Fire Rune fed to the bench pushes `heat`
  // exactly the way any fire-bearing material would. That is what keeps runes *inputs to the
  // systems we already have* (infusion, Attune, fabrication) instead of a parallel magical
  // currency (docs/professions.md §16).
  //
  // Level is what makes handling essence safe: the higher rungs are the volatile ones.
  {
    "id": "action.cut_rune_blanks",
    "professionId": "profession.runecrafting",
    "name": "Cut Rune Blanks",
    "requiredLevel": 1,
    "baseIntervalTicks": 110,
    "experience": 12,
    "inputs": [ { "itemId": "material.slate", "quantity": 2 } ],
    "outputs": [ { "itemId": "material.rune_blank", "quantity": 2 } ]
  },
  {
    "id": "action.inscribe_fire_rune",
    "professionId": "profession.runecrafting",
    "name": "Inscribe a Fire Rune",
    "requiredLevel": 10,
    "baseIntervalTicks": 150,
    "experience": 24,
    "inputs": [
      { "itemId": "material.rune_blank", "quantity": 1 },
      { "itemId": "material.fire_mote", "quantity": 1 }
    ],
    "outputs": [ { "itemId": "material.fire_rune", "quantity": 1 } ]
  },
