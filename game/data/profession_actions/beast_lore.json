[
  // Beast Lore reads the animal. Every action here consumes a carcass and returns parts that
  // already exist in fauna.json — the profession adds no new material, only access to them.
  //
  // The quick/full pairs are the point. A field dressing is fast and takes the obvious part; a
  // full harvest takes three or four times as long and strips the animal properly. Inside a
  // Realm that difference is time not spent extracting, which is exactly the decision the
  // design asks for (docs/professions.md §6). Level is what makes the deeper anatomy legible
  // at all — the tusk, the gland, the marrow are gated, not merely rarer.
  {
    "id": "action.dress_rabbit",
    "professionId": "profession.beast_lore",
    "name": "Dress Rabbit",
    "requiredLevel": 1,
    "baseIntervalTicks": 70,
    "experience": 9,
    "inputs": [ { "itemId": "material.rabbit_carcass", "quantity": 1 } ],
    "outputs": [ { "itemId": "material.rabbit_meat", "quantity": 1 } ],
    "bonusOutputs": [ { "itemId": "material.rabbit_fur", "chance": 0.5, "quantity": 1 } ]
  },
  {
    "id": "action.dress_fowl",
    "professionId": "profession.beast_lore",
    "name": "Dress Fowl",
    "requiredLevel": 3,
    "baseIntervalTicks": 70,
