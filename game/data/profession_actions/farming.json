[
  // Farming owns plants and fungi as a *domain*, wild or planted — the four wild-gathering
  // actions that used to sit under Herblore moved here in the 20-profession pass, because
  // Herblore's identity is preparation, not collection. `action.gather_sageleaf` kept its id
  // (the Dark Forest's Dark Grove points at it) and only changed profession.
  //
  // The `plant_*` actions are the plot loop: their input is the seed, their interval is the
  // grow time, and every bed returns its own seed so an established plot sustains itself. They
  // run through FarmingPlots, which pays for the seed at planting and completes the action
  // when the crop is lifted — so XP, mastery and bonus outputs behave exactly as elsewhere.

  // --- Wild collection ------------------------------------------------------------------
  {
    // Water had no source before the 20-profession pass, despite four actions consuming it —
    // brewing, cooking and felting all quietly assumed a full bucket. Farming draws it,
    // because Farming is the profession that is already standing at the Hideout well.
    "id": "action.draw_water",
    "loot_table": "loot.gather.foraging",
    "professionId": "profession.farming",
    "name": "Draw Water",
    "requiredLevel": 1,
    "baseIntervalTicks": 70,
    "experience": 6,
    "outputs": [ { "itemId": "material.springwater", "quantity": 2 } ],
    "bonusOutputs": [ { "itemId": "material.rainwater", "chance": 0.35, "quantity": 1 } ]
  },
