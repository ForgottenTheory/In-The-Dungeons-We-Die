        "extraIntervalTicks": 260,
        "riskWeight": 0.40,
        "outputs": [ { "itemId": "material.griffin_feather", "quantity": 2 } ],
        "bonusOutputs": [ { "itemId": "material.bird_egg", "chance": 0.4, "quantity": 1 } ],
        "experience": 70
      }
    ]
  },
  {
    "id": "action.crawl_the_cave_ceiling",
