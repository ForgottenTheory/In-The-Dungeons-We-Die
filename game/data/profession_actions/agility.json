[
  // Agility's main XP faucet is the Hideout training course (training_obstacles/), not these.
  // What these four are is the *other* half of the profession's identity: reach. High Agility
  // is what gets you to material nobody else can stand next to — the nesting ledge, the cave
  // ceiling, the far side of the chasm, the bottom of the shaft. None of it is exclusive
  // material; it is ordinary material behind a traversal gate (docs/professions.md §18).
  {
    "id": "action.scale_the_cliff_face",
    "professionId": "profession.agility",
    "name": "Scale the Cliff Face",
    "requiredLevel": 10,
    "baseIntervalTicks": 150,
    "experience": 22,
    "outputs": [ { "itemId": "material.peak_crystal", "quantity": 1 } ],
    "bonusOutputs": [ { "itemId": "material.griffin_feather", "chance": 0.15, "quantity": 1 } ],
    "opportunities": [
      {
        "id": "opportunity.the_nesting_ledge",
        "name": "The Nesting Ledge",
        "prompt": "There is a ledge above you with a nest on it. Going up is a committed climb — coming back down is the part to think about.",
