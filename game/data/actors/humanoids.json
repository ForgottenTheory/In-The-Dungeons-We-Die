[
  // Wave 1 of the enemy-breadth pass: the speaking, scheming, tool-using half.
  //
  // An actor is deliberately thin — name + family + role + moveset. Everything numeric composes
  // from the layers (M2′c), which is why a file of thirty enemies has no stat blocks in it.
  //
  // ── PICKING A MOVESET IS NOT FREE ──────────────────────────────────────────────────────────
  //
  // The validator checks that the RESOLVED brain can select from the moves listed here, so the
  // moveset has to match the role:
  //
  //   skirmisher  needs move.expose_weakness + an action:attack move
  //   brute       needs action:attack + mech:stagger + move.brace
  //   caster      needs move.venom_bolt + move.wither + action:spell + action:attack
  //   archer      needs delivery:ranged + action:attack
  //   stalker     needs action:attack
  //   guardian    needs action:attack + action:defensive
  //   champion    needs action:attack + mech:stagger + mech:impairment
  //
  // And enemies cannot satisfy `equippedTag`, so move.heavy_strike, move.shield_bash,
  // move.sunder, move.skewer, move.whirlwind and move.execute are OFF LIMITS here — they are
  // player weapon moves. The validator will tell you, but it is quicker to know.
  //
  // No actor below carries its own `loot_table`: family + role already pays, and an identity
  // table is for the ones worth seeking out specifically. Those come with the named bosses.

  // ══ GOBLINOIDS ══════════════════════════════════════════════════════════════════════════════
  // (actor.goblin_raider / _brute / _hexer predate this pass and keep their own files.)

  { "id": "actor.goblin_archer", "name": "Goblin Archer", "family": "family.goblin", "role": "role.archer",
    "moves": ["move.arrow_shot", "move.quick_stab"] },

  { "id": "actor.goblin_rogue", "name": "Goblin Rogue", "family": "family.goblin", "role": "role.stalker",
    "moves": ["move.quick_stab", "move.goblin_slash"] },

  { "id": "actor.goblin_berserker", "name": "Goblin Berserker", "family": "family.goblin", "role": "role.brute",
    "moves": ["move.goblin_smash", "move.overhead_crush", "move.brace"] },

  { "id": "actor.goblin_shaman", "name": "Goblin Shaman", "family": "family.goblin", "role": "role.caster",
    "moves": ["move.venom_bolt", "move.wither", "move.goblin_slash"] },

  { "id": "actor.goblin_chief", "name": "Goblin Chief", "family": "family.goblin", "role": "role.champion",
