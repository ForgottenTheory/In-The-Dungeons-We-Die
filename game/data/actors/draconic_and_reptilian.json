[
  // Wave 2 — scaled things. Dragons, drakes, serpents, and everything that basks.
  //
  // Moveset rules are in `humanoids.json`'s header. The short version: the role's brain decides
  // which moves an actor MUST carry, and the archetype weapon moves (backstab, cleave, rend,
  // pulverize, spear_thrust, aimed_shot, bolt_shot, staff_sweep, flail_crush) are all gated on
  // equipment tags, so enemies cannot use those either — only the ungated library.
  //
  // The elemental dragons differ by ONE move. That is the whole point of the layering: a Frost
  // Dragon is not a new stat block, it is a Dragon that reaches for Frost Lance.

  // ══ DRAGONS ═════════════════════════════════════════════════════════════════════════════════

  { "id": "actor.dragon", "name": "Dragon", "family": "family.draconic", "role": "role.champion",
    "moves": ["move.crash", "move.expose_weakness", "move.overhead_crush"] },

  { "id": "actor.forest_dragon", "name": "Forest Dragon", "family": "family.draconic", "role": "role.champion",
