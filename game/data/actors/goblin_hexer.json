{
  // The framework proof (M2′c): ranged/spell/status behaviour from pure configuration —
  // every move is the shared library's, the brain is the shared caster profile, and the
  // actor-level mana tweak demonstrates the final override layer.
  "id": "actor.goblin_hexer",
  "name": "Goblin Hexer",
  "family": "family.goblin",
  "role": "role.caster",
  // +12 health on top of the caster role.s -6: without it the Hexer resolves to 24 HP and the
  // FIRST fight at depth 2 is weaker than the depth-1 Raider (30). Casters are meant to be
  // squishy, not a step backwards.
  "resource_tweaks": { "mana": 20, "health": 12 },
  "moves": ["move.venom_bolt", "move.wither", "move.arcane_dart", "move.goblin_slash"],
  "loot_table": "loot.actor.goblin_hexer"
}
