[
  // Wave 2 — the dead, in both of their kinds.
  //
  // Moveset rules: see `humanoids.json`'s header.
  //
  // family.undead is bone and preserved flesh: hammers do the work, points pass through.
  // family.spirit is not there at all: physical barely applies, magic is the whole answer.
  // Getting an entry into the right one of those two is the only real decision in this file —
  // a Draugr is undead, a Shade is a spirit, and mixing them up quietly ruins a fight.

  // ══ SKELETONS ═══════════════════════════════════════════════════════════════════════════════

  { "id": "actor.skeleton", "name": "Skeleton", "family": "family.undead", "role": "role.skirmisher",
    "moves": ["move.rusty_slash", "move.expose_weakness"] },

  { "id": "actor.skeleton_mage", "name": "Skeleton Mage", "family": "family.undead", "role": "role.caster",
    "moves": ["move.venom_bolt", "move.wither", "move.arcane_dart", "move.unarmed"] },

  { "id": "actor.skeleton_champion", "name": "Skeleton Champion", "family": "family.undead", "role": "role.champion",
    "moves": ["move.overhead_crush", "move.expose_weakness", "move.iron_slash"] },

