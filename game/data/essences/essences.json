[
  // The seven typed essences (§5.2). No arcane essence, deliberately (§5.2.1) — arcane is a
  // property, the medium elements travel through. Anchors are the mundane properties each
  // essence rides along with; oppositions annihilate on contact (§8.5), so only the
  // asymmetry survives.
  { "id": "essence.fire",     "name": "Fire",     "anchor": "heat",      "opposes": ["frost"] },
  { "id": "essence.frost",    "name": "Frost",    "anchor": "cold",      "opposes": ["fire"] },
  { "id": "essence.storm",    "name": "Storm",    "anchor": "charge",    "opposes": [] },
  { "id": "essence.nature",   "name": "Nature",   "anchor": "growth",    "opposes": ["necrotic"] },
  { "id": "essence.necrotic", "name": "Necrotic", "anchor": "decay",     "opposes": ["nature", "radiant"] },
  { "id": "essence.radiant",  "name": "Radiant",  "anchor": "resonance", "opposes": ["necrotic", "abyssal"] },
  { "id": "essence.abyssal",  "name": "Abyssal",  "anchor": "corrosion", "opposes": ["radiant"] }
]
