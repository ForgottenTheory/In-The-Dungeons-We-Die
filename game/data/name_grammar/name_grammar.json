[
  // --- Intensity ladders (§13.2) --------------------------------------------------------
  // Four tiers, weakest first. Intensity is expressed through vocabulary, never through
  // "Greater"/"Lesser" — a hot material is Searing, not Greater Warmed.
  //
  // Reactive properties come first when a material carries several, because what a material
  // *does* is more interesting than what it is made of.

  { "id": "intensity.heat",      "words": ["Warmed", "Emberlit", "Cindered", "Searing"] },
  { "id": "intensity.cold",      "words": ["Cooled", "Chilled", "Rimebound", "Glacial"] },
  { "id": "intensity.charge",    "words": ["Charged", "Livewired", "Levinstruck", "Tempestbound"] },
  { "id": "intensity.toxicity",  "words": ["Tainted", "Venomed", "Blighted", "Virulent"] },
  { "id": "intensity.growth",    "words": ["Quickened", "Verdant", "Flourishing", "Rampant"] },
  { "id": "intensity.decay",     "words": ["Faded", "Withered", "Rotted", "Putrid"] },
  { "id": "intensity.corrosion", "words": ["Etched", "Pitted", "Scoured", "Caustic"] },
  { "id": "intensity.arcane",    "words": ["Touched", "Runed", "Eldritch", "Numinous"] },

  // Structural ladders. Used only when nothing reactive stands out, so an ordinary alloy
  // still reads as something rather than falling back to a bare root noun.

  { "id": "intensity.hardness",     "words": ["Firm", "Tempered", "Hardened", "Adamant"] },
  { "id": "intensity.mass",         "words": ["Slight", "Weighty", "Dense", "Leaden"] },
  { "id": "intensity.flexibility",  "words": ["Stiff", "Pliant", "Supple", "Lithe"] },
  { "id": "intensity.affinity",     "words": ["Closed", "Receptive", "Eager", "Ravenous"] },
  { "id": "intensity.conductivity", "words": ["Dulled", "Quickened", "Conductive", "Lightning-Veined"] },
  { "id": "intensity.insulation",   "words": ["Bare", "Lined", "Muffled", "Deadened"] },
  { "id": "intensity.solubility",   "words": ["Bound", "Loosened", "Yielding", "Dissolute"] },
  { "id": "intensity.instability",  "words": ["Settled", "Restless", "Fitful", "Volatile"] },
  { "id": "intensity.resonance",    "words": ["Mute", "Humming", "Resonant", "Singing"] },

  // --- Form nouns (§13.3) ----------------------------------------------------------------
  // The noun a form contributes. `metal` and `ingot` are deliberately absent: "Iron" already
  // reads as metal, and "Iron Metal" is worse than "Iron".

  { "id": "form.powder",  "words": ["Dust"] },
  { "id": "form.ash",     "words": ["Ash"] },
  { "id": "form.liquid",  "words": ["Tincture"] },
  { "id": "form.oil",     "words": ["Oil"] },
  { "id": "form.tar",     "words": ["Pitch"] },
  { "id": "form.sludge",  "words": ["Sludge"] },
  { "id": "form.slime",   "words": ["Slime"] },
  { "id": "form.gas",     "words": ["Vapour"] },
  { "id": "form.crystal", "words": ["Shard"] },
  { "id": "form.glass",   "words": ["Glass"] },
  { "id": "form.gem",     "words": ["Gem"] },
  { "id": "form.stone",   "words": ["Stone"] },
  { "id": "form.sand",    "words": ["Sand"] },
  { "id": "form.salt",    "words": ["Salt"] },
  { "id": "form.coal",    "words": ["Coal"] },
  { "id": "form.ore",     "words": ["Ore"] },
  { "id": "form.earth",   "words": ["Loam"] },
  { "id": "form.soil",    "words": ["Soil"] },
  { "id": "form.resin",   "words": ["Resin"] },
  { "id": "form.fiber",   "words": ["Fiber"] },
  { "id": "form.wood",    "words": ["Wood"] },
  { "id": "form.bark",    "words": ["Bark"] },
  { "id": "form.hide",    "words": ["Hide"] },
  { "id": "form.bone",    "words": ["Bone"] },
  { "id": "form.chitin",  "words": ["Chitin"] },
  { "id": "form.core",    "words": ["Core"] },
  { "id": "form.mote",    "words": ["Mote"] }
]
