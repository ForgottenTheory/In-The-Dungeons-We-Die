[
  // Physiology layer (M2′c): what a creature IS. Behaviour lives in enemy_roles/ai_profiles.
  //
  // ── HOW TO READ A FAMILY ────────────────────────────────────────────────────────────────────
  //
  // A family answers one question: *what is this body made of, and how does it fail?* It owns
  // attributes, resources, lane resistances, damage-type vulnerability, resolve and the anatomy
  // half of the drop. It owns NO moves and NO behaviour — an orc and an orc shaman share this
  // entry and differ by role.
  //
  // `vulnerable` is keyed by damage TYPE (Slashing/Crushing/Piercing/Magic) and clamps to
  // [0.50, 1.50]. `resistances` is keyed by LANE, and a NEGATIVE value there is a real
  // weakness — that is how a troll burns.
  //
  // ── WHY THESE FAMILIES ──────────────────────────────────────────────────────────────────────
  //
  // Granularity is physiological, not nominal. A Hill Troll and a Frost Troll are one family
  // (same body, same regeneration, same fear of fire) separated by role and actor. A Skeleton
  // and a Wraith are NOT one family, because one is bone and the other is not there.
  //
  // Attribute scale: the goblin's 7 strength is deliberately weak, family.human sits at a flat
  // 10 across the board and is what the scale is calibrated against, and giants run past 20.
  // Health here is the baseline before the role's delta.

  // ══ GOBLINOIDS AND GREENSKINS ═══════════════════════════════════════════════════════════════

  {
    "id": "family.goblin", "name": "Goblin",
    "tags": ["family:goblin"],
    "attributes": { "strength": 7, "dexterity": 8, "intelligence": 3, "constitution": 6, "wisdom": 4, "endurance": 7, "luck": 4 },
    "resources": { "health": 30, "mana": 0, "stamina": 40 },
    // A lifetime of eating things nothing should eat.
    "resistances": { "toxin": 0.25 },
    "resolve": 50,
    // What a goblin body is made of. Rolled alongside the role's and the actor's tables, so a
    // new goblin needs only its own identity table — or none at all.
    "loot_table": "loot.family.goblin"
  },

  {
    // Bigger, drilled, and armoured where a goblin is merely lucky. The discipline is the role's
    // business; the frame is this entry's.
    "id": "family.hobgoblin", "name": "Hobgoblin",
    "tags": ["family:hobgoblin", "family:goblinoid"],
    "attributes": { "strength": 11, "dexterity": 9, "intelligence": 6, "constitution": 10, "wisdom": 6, "endurance": 10, "luck": 4 },
