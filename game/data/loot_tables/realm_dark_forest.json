[
  // ── The Dark Forest's own tables ───────────────────────────────────────────────────────────
  //
  // A Gather node's table is the REALM'S LAYER OVER a profession action: the action still pays
  // what it always pays (and rolls its own profession drop table), and this is what being here
  // — in a place that can kill you, with unsecured pockets — adds on top. It rolls only when
  // the attempt actually lands, so standing on a node is never a free faucet.
  //
  // An Event node's table simply IS the node: the chest, the kill site, the cache.
  //
  // This is where essence and coin live, per D29.3 and the same reasoning: extraction keeps the
  // practical monopoly on the supernatural tier, and on being paid.

  // ---- Depth 1 -----------------------------------------------------------------------------

  {
    "id": "loot.node.old_grove",
    "name": "Old Grove",
    "weightedDraws": [
      {
        "picks": 1,
        "entries": [
          { "tableId": "loot.shared.forest_reagents", "weight": 30 },
          { "itemId": "material.elder_bark", "weight": 14 },
          { "itemId": "material.pine_resin", "weight": 12 },
          { "itemId": "material.lichen", "weight": 10 },
          { "dropsNothing": true, "weight": 34 }
        ]
      },
      {
        "picks": 1,
        "entries": [
          { "tableId": "loot.shared.fey_essence", "weight": 12 },
          { "itemId": "material.mana_seed", "weight": 4 },
          { "dropsNothing": true, "weight": 84 }
        ]
      }
    ]
  },

