[
  // ── Family and role tables for the enemy-breadth pass ──────────────────────────────────────
  //
  // Same three-layer composition as `enemies.json` (D26): family = what the body is made of,
  // role = what the archetype was carrying, actor = what makes this one worth hunting. These
  // are the first two layers for every family and role added by the breadth pass.
  //
  // D28 holds without exception here: every entry is an INPUT. Nothing in this file is a
  // finished weapon or a wearable piece — what the Guardian was holding arrives as scrap iron
  // and the sword it becomes is fabricated at the bench.
  //
  // Every family carries `loot.shared.rank_spoils`, which pays nothing until the kill actually
  // has an elite or boss rank. One line, and the whole file is rank-ready.

  // ══ GOBLINOIDS AND GREENSKINS ═══════════════════════════════════════════════════════════════

  {
    "id": "loot.family.hobgoblin",
    "name": "Hobgoblin",
    "tags": ["source:creature", "source:goblinoid"],
    "alwaysDrops": [
      { "itemId": "material.goblin_hide", "minQuantity": 1, "maxQuantity": 3 },
      { "tableId": "loot.shared.rank_spoils" }
    ],
    "chanceDrops": [
      { "itemId": "material.scrap_iron", "chance": 0.45, "minQuantity": 1, "maxQuantity": 2 },
      { "itemId": "material.tattered_cloth", "chance": 0.30 }
    ]
  },

