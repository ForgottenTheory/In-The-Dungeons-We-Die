[
  // ── Gathering drop tables ──────────────────────────────────────────────────────────────────
  //
  // One table per gathering profession, shared by every one of its actions. These are the things
  // the work TURNS UP rather than the things it produces: the seed shaken loose from a felled
  // tree, the grub in the bait tin, the crystal in the ore pocket.
  //
  // Not `bonusOutputs`, and the distinction is load-bearing. A bonus output is more of the same
  // work and scales with mastery and performance — a profession-progression lever. A drop table
  // does not scale; it expresses weighted variety, quantity ranges and shared libraries.
  //
  // EVERY TABLE HERE HAS THE SAME SHAPE:
  //   draw 1  — no condition        → what any attempt might turn up, passive or active
  //   draw 2  — requiresTags:active → what only somebody actually standing there would notice
  //
  // That second draw is the structural version of "active Realm gathering reaches better and
  // stranger rewards than safe passive training". It is a fact about the content, not a tuning
  // number — passive play cannot reach those entries at any rate.
  //
  // D29.3: none of these may reach `loot.shared.fey_essence`, and none of them declares gold.
  // Essence and coin are the Realm's export. A test enforces both.

  {
    "id": "loot.gather.forestry",
    "name": "What the Tree Gives Up",
    "chanceDrops": [
      { "itemId": "material.green_moss", "chance": 0.18 }
    ],
    "weightedDraws": [
      {
        "picks": 1,
