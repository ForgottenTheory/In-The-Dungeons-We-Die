  // ---- Rank spoils: the seam for elites and bosses ------------------------------------------
  //
  // Every family table nests this one line. Nothing carries the `elite` or `boss` tag today, so
  // it pays out nothing — and the day an elite is authored, giving it the tag is the entire
  // change. The context tags come from the resolved actor's own identity tags, so no code has
  // to learn what an elite is.

  {
    "id": "loot.shared.rank_spoils",
    "name": "Spoils of Rank",
    "weightedDraws": [
      {
        "picks": 1,
        "when": { "requiresTags": ["elite"] },
        "entries": [
          { "tableId": "loot.shared.elite_spoils", "weight": 100 }
        ]
      },
      {
        "picks": 1,
        "when": { "requiresTags": ["boss"] },
        "entries": [
          { "tableId": "loot.shared.boss_spoils", "weight": 100 }
        ]
      }
    ]
  },

  {
    "id": "loot.shared.elite_spoils",
    "name": "An Elite's Hoard",
    "tags": ["source:elite"],
    "alwaysDrops": [
      { "tableId": "loot.shared.crafting_catalysts" }
    ],
    "chanceDrops": [
      { "itemId": "material.relic_shard", "chance": 0.15 }
    ],
    "weightedDraws": [
      {
        "picks": 2,
        "entries": [
          { "tableId": "loot.shared.knowledge_rare", "weight": 26 },
          { "tableId": "loot.shared.fey_essence", "weight": 24 },
          { "tableId": "loot.shared.salvage_heavy", "weight": 22 },
          { "tableId": "loot.shared.techniques_martial", "weight": 8 },
          { "tableId": "loot.shared.techniques_arcane", "weight": 8 },
          { "dropsNothing": true, "weight": 12 }
        ]
      }
    ],
    "gold": { "minAmount": 25, "maxAmount": 70, "chance": 0.9 }
  },

  {
    "id": "loot.shared.boss_spoils",
    "name": "A Boss's Hoard",
    "tags": ["source:boss"],
    // D28 sub-ruling 1: the chase item is a *material* with an impossible profile, not a sword.
    // The relic material itself is post-slice content; the shard is the placeholder that keeps
    // the shape honest until it lands.
    "alwaysDrops": [
      { "tableId": "loot.shared.knowledge_rare" },
      { "itemId": "material.relic_shard", "minQuantity": 1, "maxQuantity": 2 }
    ],
    "weightedDraws": [
      {
        "picks": 3,
        "entries": [
          { "tableId": "loot.shared.fey_essence", "weight": 30 },
          { "tableId": "loot.shared.crafting_catalysts", "weight": 24 },
          { "tableId": "loot.shared.techniques_arcane", "weight": 14 },
          { "tableId": "loot.shared.techniques_martial", "weight": 14 },
          { "tableId": "loot.shared.salvage_heavy", "weight": 18 }
        ]
      }
    ],
    "gold": { "minAmount": 80, "maxAmount": 200, "chance": 1.0 }
  }
]
