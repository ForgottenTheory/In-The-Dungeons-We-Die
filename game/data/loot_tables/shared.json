[
  // ── The shared loot library ────────────────────────────────────────────────────────────────
  //
  // Nothing in this file is attached to a source. These are the tables everything else *nests*,
  // and they are the reason a new enemy, node or profession action becomes lootable in one line
  // of JSON instead of thirty. A creature that does not exist yet is made lootable by pointing
  // its `loot_table` at the tables that already ship here.
  //
  // A table's own `tags` join the context for everything nested beneath it, so a shared table
  // can ask who reached it — `source:creature` is what lets one anatomy table serve every body.
  //
  // D28: realms drop INPUTS. Nothing here yields finished equipment, and a test enforces it.

  // ---- Bodies ------------------------------------------------------------------------------

  {
    "id": "loot.shared.creature_remains",
    "name": "Creature Remains",
    "tags": ["source:creature"],
    // What is left of anything that was alive. Deliberately species-agnostic: the parts that
    // identify a creature belong on its own table, and the parts every carcass has belong here.
    "chanceDrops": [
      { "itemId": "material.animal_bone", "chance": 0.40, "minQuantity": 1, "maxQuantity": 2 },
      { "itemId": "material.animal_blood", "chance": 0.25 }
    ],
    "weightedDraws": [
      {
        "picks": 1,
        "entries": [
          { "itemId": "material.beast_liver", "weight": 14 },
          { "itemId": "material.beast_heart", "weight": 8 },
          { "itemId": "material.musk_gland", "weight": 6 },
          { "dropsNothing": true, "weight": 72 }
        ]
      }
    ]
  },

  {
    // The Dire Wolf shape from the design brief, authored ahead of the creature that will use
    // it. When a beast family ships, its definition points `loot_table` here and it is done —
    // no code, no new tables, nothing re-authored.
    //
    // It is live content today rather than a comment: the Ravaged Kill event reaches it, so it
    // is rolled in real play and pinned by test. A table nothing can roll is a table nothing
    // tests, and untested loot is loot that has quietly stopped paying out.
    "id": "loot.template.beast_anatomy",
    "name": "Beast Anatomy",
    "tags": ["source:creature", "source:beast"],
    "chanceDrops": [
      { "itemId": "material.wolf_meat", "chance": 0.55, "minQuantity": 1, "maxQuantity": 2 },
      { "itemId": "material.wolf_hide", "chance": 0.45 },
      { "itemId": "material.wolf_fang", "chance": 0.30, "minQuantity": 1, "maxQuantity": 2 }
    ],
    "weightedDraws": [
      {
        "picks": 1,
        "entries": [
          { "tableId": "loot.shared.creature_remains", "weight": 40 },
          { "itemId": "material.wolf_fur", "weight": 22 },
          { "itemId": "material.deer_sinew", "weight": 14 },
          { "dropsNothing": true, "weight": 24 }
        ]
      },
      {
        // The rare gland and the essence-bearing part the brief asks for: deep only, so a
        // depth-1 kill never trivialises what a depth-2 one is for.
        "picks": 1,
        "when": { "minDepth": 2 },
        "entries": [
          { "itemId": "material.venom_gland", "weight": 10 },
          { "itemId": "material.direwolf_pelt", "weight": 6 },
          { "tableId": "loot.shared.fey_essence", "weight": 8 },
          { "dropsNothing": true, "weight": 76 }
        ]
      }
    ]
  },

  // ---- Carried goods -----------------------------------------------------------------------

  {
    "id": "loot.shared.salvage_light",
    "name": "Scavenged Oddments",
    "tags": ["source:salvage"],
    // D28 sub-ruling 3: enemy-wielded equipment arrives as salvage, never as gear. This is what
    // a lightly-armed thing was carrying, in the only form the bench can use.
    "chanceDrops": [
      { "itemId": "material.scrap_iron", "chance": 0.40, "minQuantity": 1, "maxQuantity": 2 },
      { "itemId": "material.tattered_cloth", "chance": 0.35, "minQuantity": 1, "maxQuantity": 2 }
    ],
    "weightedDraws": [
      {
        "picks": 1,
        "entries": [
          { "itemId": "material.salvage_pile", "weight": 20 },
          { "itemId": "material.leather_strap", "weight": 16 },
          { "itemId": "material.hemp_thread", "weight": 14, "minQuantity": 1, "maxQuantity": 2 },
          { "itemId": "material.flint", "weight": 10 },
          { "itemId": "material.broken_mechanism", "weight": 6 },
          { "dropsNothing": true, "weight": 34 }
        ]
      }
    ]
  },

  {
    "id": "loot.shared.salvage_heavy",
    "name": "Battered Warplate",
    "tags": ["source:salvage"],
    "alwaysDrops": [
      { "itemId": "material.scrap_iron", "minQuantity": 1, "maxQuantity": 3 }
