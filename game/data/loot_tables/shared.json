    "weightedDraws": [
      {
        "picks": 1,
        "entries": [
          { "itemId": "material.salvage_pile", "weight": 24, "minQuantity": 1, "maxQuantity": 2 },
          { "itemId": "material.broken_mechanism", "weight": 15 },
          { "itemId": "material.iron_ingot", "weight": 10 },
          { "itemId": "material.tool_head", "weight": 8 },
          { "itemId": "material.schematic_fragment", "weight": 5 },
          { "dropsNothing": true, "weight": 38 }
        ]
      }
    ]
  },

