  {
    "id": "loot.shared.crafting_catalysts",
    "name": "Prepared Reagents",
    "tags": ["source:reagents"],
    // Catalysts are somebody else's prepared work — a hexer's pouch, a wrecked alchemist's
    // crate. They are never gathered raw, which is why they only ever appear through a table.
    "weightedDraws": [
      {
        "picks": 1,
        "entries": [
          { "itemId": "material.catalytic_salt", "weight": 30 },
          { "itemId": "material.stabilizing_agent", "weight": 24 },
          { "itemId": "material.concentrated_extract", "weight": 16 },
          { "itemId": "material.prepared_venom", "weight": 10 },
          { "itemId": "material.arcane_solvent", "weight": 8, "when": { "minDepth": 2 } },
          { "itemId": "material.resonance_catalyst", "weight": 4, "when": { "minDepth": 2 } },
          { "dropsNothing": true, "weight": 18 }
        ]
      }
    ]
  },

  {
    // D29.3, the standing rule this table exists to obey: essence is the Realm's export.
    // Nothing here may be reached from a profession action's drop table — a test enforces it —
    // so the first meaningful essence craft stays a post-extraction milestone.
    "id": "loot.shared.fey_essence",
    "name": "Something the Forest Kept",
    "tags": ["source:essence"],
    "weightedDraws": [
      {
        "picks": 1,
        "entries": [
          { "itemId": "material.rotroot", "weight": 26 },
          { "itemId": "material.tainted_water", "weight": 20 },
          { "itemId": "material.spirit_bark", "weight": 12, "when": { "minDepth": 2 } },
          { "itemId": "material.wraith_essence", "weight": 10, "when": { "minDepth": 2 } },
          { "itemId": "material.curse_dust", "weight": 8, "when": { "minDepth": 2 } },
          { "itemId": "material.death_mote", "weight": 6, "when": { "minDepth": 2 } },
          { "itemId": "material.spiritwood_log", "weight": 5, "when": { "minDepth": 2 } },
          { "itemId": "material.livingbark_log", "weight": 2, "when": { "minDepth": 2 } },
          { "dropsNothing": true, "weight": 28 }
        ]
      }
    ]
  },

