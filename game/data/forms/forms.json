[
  // Fabrication forms (C2a §16.2) — the terminal boundary where materials become equipment.
  //
  // ── HOW TO READ A FORM ──────────────────────────────────────────────────────────────────────
  //
  // `slots`      named components. `requires_tags` is ANY-OF. `mass_share` is what fraction of
  //              the item this component IS (they sum to 1.0 — validated). `trait_expression`
  //              gates how much of each trait category this position lets through; the rest
  //              goes dormant.
  // `stat_map`   what the finished item's stats READ. A named slot reads only that component;
  //              `"*"` reads the mass-share-weighted total. This is the single most important
  //              field in the file: it is why the same iron ingot is excellent in one form and
  //              wasted in another, and it is what `ItemPotential.MaterialInfluence` weights
  //              when it decides which modifiers are even eligible.
  //
  // ── WHY THESE FORMS ─────────────────────────────────────────────────────────────────────────
  //
  // Each form exists to exercise a different part of the material system, not to add variety:
  //
  //   Longsword   hardness-led, three slots      — the calibration reference (iron-sword parity)
  //   Warspear    flexibility-led, mass in the   — the same iron that makes a great sword makes
  //               haft rather than the head        a mediocre spear. The counter-example.
  //   Buckler     one slot, all of it            — the simplest possible form; grants Parry
  //   Helm        insulation matters             — the only armour whose stat_map reads it hard
  //   Vest        hardness AND flexibility       — the trade-off form
  //   Gauntlets   flexibility-led armour         — where being too hard is a cost
  //   Treads      mass-led armour                — where being too heavy is a cost
  //   Focus       resonance + arcane             — the ONLY form that reads them, which is what
  //                                                gives resonant materials anywhere to go
  //   Ring        conductivity + affinity        — the only form reading the two properties
  //                                                nothing else looked at. Fills EITHER ring
  //                                                position (see EquipmentSlots.RingPositions)
  //
  // ── ARMOUR COVERAGE IS AUTHORED, NOT CODED ──────────────────────────────────────────────────
  //
  // A worn loadout's armour is the sum of its pieces (`EquipmentResolver.ResolveWornArmor`), and
  // each piece's contribution comes from how hard its stat_map reads `hardness`. A vest covers
  // more of you than gauntlets do, so it reads harder. There is no per-slot multiplier in the
  // code — change the weight here and the coverage changes.

  // ══ WEAPONS ═════════════════════════════════════════════════════════════════════════════════

  {
    "id": "form.longsword",
    "name": "Longsword",
    "type": "Weapon",
    "tags": ["weapon", "sword", "metal"],
    "slots": {
      "edge": {
        "requires_tags": ["form:metal", "form:crystal"],
        "mass_share": 0.60,
        "trait_expression": { "thermal": 1.0, "charge": 0.9, "toxic": 1.0, "vital": 0.2, "arcane": 0.5, "structural": 1.0 },
        "identity_priority": 3
      },
      "core": {
        "requires_tags": ["form:metal", "form:wood"],
        "mass_share": 0.25,
        "trait_expression": { "thermal": 0.3, "charge": 0.5, "toxic": 0.1, "vital": 0.3, "arcane": 0.7, "structural": 0.8 },
        "identity_priority": 2
      },
      "binding": {
        "requires_tags": ["form:hide", "form:fiber"],
        "mass_share": 0.15,
        "trait_expression": { "thermal": 0.2, "charge": 0.2, "toxic": 0.4, "vital": 0.6, "arcane": 0.3, "structural": 0.3 },
        "identity_priority": 1
      }
    },
    "stat_map": {
      "mass":     [ { "slot": "*",    "property": "mass",     "weight": 1.0 } ],
      "hardness": [ { "slot": "edge", "property": "hardness", "weight": 0.8 }, { "slot": "core", "property": "hardness", "weight": 0.2 } ]
    },
    "trait_cap": 4,
    // Identity model (Phase 3, D46/D51): the blade reads Bite off the edge and swings by its
    // whole-item Heft; the edge's identities express before the core's, the core's before the
    // binding's. identity_cap 3 — a sword states at most three ideas. The generation lean is
    // §8 stage 1: a sword pushes sentences toward landing hits, never a recipe.
    "identity_cap": 3,
    "base_reads": {
      "damage": [ { "slot": "edge", "stat": "bite", "weight": 1.0 } ],
      "speed":  [ { "slot": "*",    "stat": "heft", "weight": 1.0 } ]
    },
    "generation_profile": { "favored_triggers": ["on_hit", "on_crit"] },
    "moves": ["move.iron_slash", "move.heavy_strike"],
    // Every one-handed straight or curved blade in the library. They differ by fashion and by
    // where they were made, not by what the stat map reads off them — so they are names, and
    // adding them cost nothing but this line.
    "name_variants": ["Arming Sword", "Broadsword", "Falchion", "Scimitar", "Sabre", "Rapier", "Estoc", "Khopesh", "Kopis", "Falcata", "Dao", "Jian", "Katana", "Tachi", "Shotel", "Kilij", "Yatagan", "Talwar", "Firangi", "Messer", "Spatha", "Shamshir", "Pulwar", "Nimcha", "Flyssa", "Takoba", "Ida", "Backsword"],
    "description": "A proper blade. The material decides what kind of proper."
  },

  {
    // The deliberate counterweight to the Longsword. Almost all the mass is in the haft, and
    // the stat_map reads FLEXIBILITY from it — so a spear hafted in iron is heavy and stiff and
    // worse than one hafted in yew, while the same iron in a longsword's edge is excellent.
    // Hardness is read from the point alone, which is a quarter of the item.
    //
    // That is the whole material-genetics claim in one pair of forms: there is no best material,
    // only a best placement.
    "id": "form.warspear",
    "name": "Warspear",
    "type": "Weapon",
    "tags": ["weapon", "spear", "polearm"],
    "slots": {
      "point": {
        "requires_tags": ["form:metal", "form:crystal", "form:bone", "form:horn"],
        "mass_share": 0.25,
        "trait_expression": { "thermal": 1.0, "charge": 0.8, "toxic": 1.0, "vital": 0.2, "arcane": 0.4, "structural": 1.0 }
      },
      "haft": {
        "requires_tags": ["form:wood", "form:metal", "form:fiber"],
        "mass_share": 0.60,
        "trait_expression": { "thermal": 0.2, "charge": 0.6, "toxic": 0.1, "vital": 0.5, "arcane": 0.8, "structural": 0.7 }
      },
      "grip": {
        "requires_tags": ["form:hide", "form:fiber", "form:cloth"],
        "mass_share": 0.15,
        "trait_expression": { "thermal": 0.2, "charge": 0.2, "toxic": 0.5, "vital": 0.7, "arcane": 0.3, "structural": 0.3 }
      }
    },
    "stat_map": {
      "mass":        [ { "slot": "*",     "property": "mass",        "weight": 0.8 } ],
      "hardness":    [ { "slot": "point", "property": "hardness",    "weight": 0.9 } ],
      "flexibility": [ { "slot": "haft",  "property": "flexibility", "weight": 0.9 }, { "slot": "grip", "property": "flexibility", "weight": 0.3 } ]
    },
    "trait_cap": 4,
    // move.spear_thrust, not move.skewer: Skewer requires the `sword` tag, which a spear does
    // not carry, so it sat here unusable for the whole of C2a. A validator rule now catches it.
    "moves": ["move.spear_thrust", "move.quick_stab"],
    "name_variants": ["Spear", "Pike", "Lance", "Boar Spear", "Awl Pike", "Dory", "Sarissa", "Yari", "Hooked Spear", "Hunting Spear", "Trident", "Military Fork", "Ranseur", "Spetum", "Partisan", "Corseque"],
    "description": "Reach, and the discipline to use it. Most of a spear is the part nobody looks at."
  },

  {
    // The small blade. Almost no mass anywhere in the stat map, which is what makes it the one
    // weapon where a rare, light, hard material is not wasted on a big lump of steel.
    "id": "form.dagger",
    "name": "Dagger",
    "type": "Weapon",
    "tags": ["weapon", "dagger", "metal"],
    "slots": {
      "blade": {
        "requires_tags": ["form:metal", "form:crystal", "form:bone"],
        "mass_share": 0.75,
        "trait_expression": { "thermal": 1.0, "charge": 0.9, "toxic": 1.0, "vital": 0.2, "arcane": 0.6, "structural": 0.9 }
      },
      "hilt": {
        "requires_tags": ["form:hide", "form:fiber", "form:wood", "form:leather"],
        "mass_share": 0.25,
        "trait_expression": { "thermal": 0.2, "charge": 0.3, "toxic": 0.5, "vital": 0.7, "arcane": 0.3, "structural": 0.3 }
      }
    },
    "stat_map": {
      "hardness": [ { "slot": "blade", "property": "hardness", "weight": 0.9 } ],
      "mass":     [ { "slot": "*",     "property": "mass",     "weight": 0.35 } ]
    },
    "trait_cap": 2,
    "moves": ["move.backstab", "move.quick_stab"],
    "name_variants": ["Rondel Dagger", "Dirk", "Stiletto", "Kris", "Katar", "Push Dagger", "Parrying Dagger", "Main-Gauche", "Baselard", "Bollock Dagger", "Misericorde", "Jambiya", "Khanjar", "Kukri", "Qama", "Kindjal", "Sica", "Seax", "Cinquedea", "Skinning Knife", "Throwing Knife"],
    "description": "Small enough to carry everywhere, which is most of the argument for it."
  },

  {
    // The heavy end of the sword family: it carries the `sword` tag, so every sword move works,
    // and Cleave on top. Mass is read at OVER 1.0 off the whole item — the only form in the file
    // that wants to be heavy, which flips the usual "dense metal is a cost" pressure.
    "id": "form.greatsword",
    "name": "Greatsword",
    "type": "Weapon",
    "tags": ["weapon", "sword", "greatsword", "metal"],
    "slots": {
      "blade": {
        "requires_tags": ["form:metal", "form:crystal"],
        "mass_share": 0.70,
        "trait_expression": { "thermal": 1.0, "charge": 0.9, "toxic": 0.8, "vital": 0.2, "arcane": 0.5, "structural": 1.0 }
      },
      "crossguard": {
        "requires_tags": ["form:metal", "form:bone", "form:horn"],
        "mass_share": 0.15,
        "trait_expression": { "thermal": 0.5, "charge": 0.5, "toxic": 0.3, "vital": 0.3, "arcane": 0.5, "structural": 0.9 }
      },
      "grip": {
        "requires_tags": ["form:hide", "form:fiber", "form:leather", "form:cloth"],
        "mass_share": 0.15,
        "trait_expression": { "thermal": 0.2, "charge": 0.2, "toxic": 0.5, "vital": 0.7, "arcane": 0.3, "structural": 0.3 }
      }
    },
    "stat_map": {
      "hardness":    [ { "slot": "blade", "property": "hardness",    "weight": 0.75 } ],
      "mass":        [ { "slot": "*",     "property": "mass",        "weight": 1.20 } ],
      "flexibility": [ { "slot": "blade", "property": "flexibility", "weight": 0.25 } ]
    },
    "trait_cap": 4,
    "moves": ["move.cleave", "move.heavy_strike", "move.iron_slash"],
    "name_variants": ["Zweihander", "Flamberge", "Claymore", "Bastard Sword", "Nodachi", "Kriegsmesser", "Dadao", "Rhomphaia", "Espadon"],
    "description": "Two hands, and a good reason for both."
  },

  {
    // Head-heavy on purpose: mass is read off the HEAD alone rather than the whole item, so a
    // dense head on a light haft beats the same metal spread evenly. The opposite bookkeeping to
    // the Longsword, which reads mass across everything.
    "id": "form.battleaxe",
    "name": "Battle Axe",
    "type": "Weapon",
    "tags": ["weapon", "axe", "metal"],
    "slots": {
      "head": {
        "requires_tags": ["form:metal", "form:stone", "form:crystal"],
        "mass_share": 0.60,
        "trait_expression": { "thermal": 1.0, "charge": 0.8, "toxic": 0.7, "vital": 0.2, "arcane": 0.4, "structural": 1.0 }
      },
      "haft": {
        "requires_tags": ["form:wood", "form:fiber", "form:bone", "form:metal"],
        "mass_share": 0.40,
        "trait_expression": { "thermal": 0.3, "charge": 0.5, "toxic": 0.2, "vital": 0.6, "arcane": 0.6, "structural": 0.7 }
      }
    },
    "stat_map": {
      "hardness": [ { "slot": "head", "property": "hardness", "weight": 0.85 } ],
      "mass":     [ { "slot": "head", "property": "mass",     "weight": 0.90 } ]
    },
    "trait_cap": 3,
    "moves": ["move.rend", "move.overhead_crush"],
    "name_variants": ["Hand Axe", "Bearded Axe", "Dane Axe", "Francisca", "Tabar", "Sagaris", "Throwing Axe", "Hatchet", "Wood Axe", "Woodcutter's Axe", "Parashu", "Bhuj", "Falx"],
    "description": "Weight where the work happens, and nowhere else."
  },

  {
    // Where heavy is the whole point. Mass is read off the head at 1.4 — the highest weight in
    // the file — so this is the one form a lead or gold head is not a joke on.
    "id": "form.maul",
    "name": "Maul",
    "type": "Weapon",
    "tags": ["weapon", "maul", "hammer"],
    "slots": {
      "head": {
        "requires_tags": ["form:metal", "form:stone", "form:crystal"],
        "mass_share": 0.70,
        "trait_expression": { "thermal": 0.9, "charge": 0.7, "toxic": 0.4, "vital": 0.2, "arcane": 0.4, "structural": 1.0 }
      },
      "haft": {
        "requires_tags": ["form:wood", "form:metal", "form:bone"],
        "mass_share": 0.30,
        "trait_expression": { "thermal": 0.3, "charge": 0.4, "toxic": 0.2, "vital": 0.5, "arcane": 0.5, "structural": 0.8 }
      }
    },
    "stat_map": {
      "mass":        [ { "slot": "head", "property": "mass",        "weight": 1.40 } ],
      "hardness":    [ { "slot": "head", "property": "hardness",    "weight": 0.50 } ],
      "flexibility": [ { "slot": "haft", "property": "flexibility", "weight": 0.30 } ]
    },
    "trait_cap": 3,
    "moves": ["move.pulverize", "move.crash"],
    "name_variants": ["Warhammer", "Mace", "Flanged Mace", "Morning Star", "Club", "Cudgel", "War Club", "Knobkerrie", "Kanabo", "Tetsubo", "Goedendag", "Lucerne Hammer", "Mere", "Blacksmith Hammer", "Mining Hammer", "War Pick", "Horseman's Pick", "Zaghnal", "Pickaxe"],
    "description": "No edge, no subtlety, no argument."
  },

  {
    // THE flexibility weapon, and the sharpest counter-example in the file: a bow limbed in iron
    // is a terrible bow. Hardness barely registers and mass is a cost, so every instinct the
    // Longsword teaches is wrong here — which is exactly why yew, horn and sinew exist.
    "id": "form.longbow",
    "name": "Longbow",
    "type": "Weapon",
    "tags": ["weapon", "bow"],
    "slots": {
      "limb": {
        "requires_tags": ["form:wood", "form:horn", "form:bone", "form:fiber"],
        "mass_share": 0.65,
        "trait_expression": { "thermal": 0.4, "charge": 0.5, "toxic": 0.3, "vital": 0.8, "arcane": 0.7, "structural": 0.9 }
      },
      "string": {
        "requires_tags": ["form:fiber", "form:hide", "form:cloth"],
        "mass_share": 0.20,
        "trait_expression": { "thermal": 0.2, "charge": 0.4, "toxic": 0.4, "vital": 0.7, "arcane": 0.4, "structural": 0.4 }
      },
      "grip": {
        "requires_tags": ["form:hide", "form:leather", "form:cloth", "form:wood"],
        "mass_share": 0.15,
        "trait_expression": { "thermal": 0.2, "charge": 0.2, "toxic": 0.5, "vital": 0.7, "arcane": 0.3, "structural": 0.3 }
      }
    },
    "stat_map": {
      "flexibility": [ { "slot": "limb", "property": "flexibility", "weight": 1.10 }, { "slot": "string", "property": "flexibility", "weight": 0.40 } ],
      "hardness":    [ { "slot": "limb", "property": "hardness",    "weight": 0.20 } ],
      "mass":        [ { "slot": "*",    "property": "mass",        "weight": 0.25 } ]
    },
    "trait_cap": 3,
    "moves": ["move.aimed_shot", "move.arrow_shot"],
    "name_variants": ["Shortbow", "Recurve Bow", "Composite Bow", "War Bow", "Hunting Bow"],
    "description": "Stores everything you put into it, and gives it all back at once."
  },

  {
    // The bow's opposite answer to the same problem: where a bow needs a limb that bends and
    // returns, a crossbow spends hardness on a MECHANISM and holds the draw for you. Reads
    // hardness off the smallest slot in the file, which is a real placement puzzle.
    "id": "form.crossbow",
    "name": "Crossbow",
    "type": "Weapon",
    "tags": ["weapon", "crossbow"],
    "slots": {
      "prod": {
        "requires_tags": ["form:metal", "form:wood", "form:horn", "form:bone"],
        "mass_share": 0.45,
        "trait_expression": { "thermal": 0.6, "charge": 0.6, "toxic": 0.3, "vital": 0.5, "arcane": 0.5, "structural": 1.0 }
      },
      "stock": {
        "requires_tags": ["form:wood", "form:bone", "form:metal"],
        "mass_share": 0.40,
        "trait_expression": { "thermal": 0.3, "charge": 0.4, "toxic": 0.2, "vital": 0.6, "arcane": 0.6, "structural": 0.7 }
      },
      "mechanism": {
        "requires_tags": ["form:metal", "form:bone", "form:horn"],
        "mass_share": 0.15,
        "trait_expression": { "thermal": 0.7, "charge": 0.8, "toxic": 0.2, "vital": 0.2, "arcane": 0.6, "structural": 1.0 }
      }
    },
    "stat_map": {
      "hardness":    [ { "slot": "mechanism", "property": "hardness",    "weight": 0.70 }, { "slot": "prod", "property": "hardness", "weight": 0.30 } ],
      "flexibility": [ { "slot": "prod",      "property": "flexibility", "weight": 0.55 } ],
      "mass":        [ { "slot": "*",         "property": "mass",        "weight": 0.80 } ]
    },
    "trait_cap": 3,
    "moves": ["move.bolt_shot"],
    "name_variants": ["Heavy Crossbow", "Hand Crossbow", "Repeating Crossbow", "Arbalest"],
    "description": "Holds the draw so you do not have to. Everything else about it is that trade."
  },

  {
    // One slot, one material, three reads — the simplest weapon in the file and the only one
    // where a single choice decides everything. The teaching form: fabricate one, then fabricate
    // it again in something else and read the difference with nothing else in the way.
    "id": "form.quarterstaff",
    "name": "Quarterstaff",
    "type": "Weapon",
    "tags": ["weapon", "staff", "polearm"],
    "slots": {
      "shaft": {
        "requires_tags": ["form:wood", "form:metal", "form:bone", "form:crystal"],
        "mass_share": 1.0,
        "trait_expression": { "thermal": 0.5, "charge": 0.7, "toxic": 0.3, "vital": 0.7, "arcane": 0.9, "structural": 0.8 }
      }
    },
    "stat_map": {
      "flexibility": [ { "slot": "shaft", "property": "flexibility", "weight": 0.80 } ],
      "mass":        [ { "slot": "shaft", "property": "mass",        "weight": 0.60 } ],
      "hardness":    [ { "slot": "shaft", "property": "hardness",    "weight": 0.40 } ]
    },
    "trait_cap": 3,
    "moves": ["move.staff_sweep", "move.quick_stab"],
    "name_variants": ["Bo Staff", "Shillelagh", "Eku", "Walking Staff"],
    "description": "A stick, until someone who knows what they are doing picks it up."
  },

  {
    // Mass in the head, flexibility in the CHAIN — the only form that wants a component to be
    // floppy. A rigid chain is a bad flail, which is a sentence no other form in the file could
    // produce.
    "id": "form.flail",
    "name": "Flail",
    "type": "Weapon",
    "tags": ["weapon", "flail"],
    "slots": {
      "head": {
        "requires_tags": ["form:metal", "form:stone", "form:crystal"],
        "mass_share": 0.50,
        "trait_expression": { "thermal": 0.9, "charge": 0.7, "toxic": 0.5, "vital": 0.2, "arcane": 0.4, "structural": 1.0 }
      },
      "chain": {
        "requires_tags": ["form:metal", "form:fiber", "form:hide"],
        "mass_share": 0.25,
        "trait_expression": { "thermal": 0.5, "charge": 0.8, "toxic": 0.3, "vital": 0.5, "arcane": 0.5, "structural": 0.6 }
      },
      "haft": {
        "requires_tags": ["form:wood", "form:metal", "form:bone"],
        "mass_share": 0.25,
        "trait_expression": { "thermal": 0.3, "charge": 0.4, "toxic": 0.2, "vital": 0.6, "arcane": 0.5, "structural": 0.7 }
      }
    },
    "stat_map": {
      "mass":        [ { "slot": "head",  "property": "mass",        "weight": 1.00 } ],
      "hardness":    [ { "slot": "head",  "property": "hardness",    "weight": 0.60 } ],
      "flexibility": [ { "slot": "chain", "property": "flexibility", "weight": 0.75 } ]
    },
    "trait_cap": 3,
    "moves": ["move.flail_crush", "move.crash"],
    "name_variants": ["Two-Handed Flail", "Chain Sickle", "Kusarigama", "Meteor Hammer", "Nunchaku"],
    "description": "It arrives after you think it has, and from a direction you did not pick."
  },

  {
    // The CHOPPING polearm, as against the Warspear's thrusting one. Same length of wood, wholly
    // different question: a spear reads flexibility off its haft because it flexes on the thrust,
    // while a halberd reads MASS off a head on the end of a lever and wants the haft stiff.
    // The two exist as a pair for the same reason the Longsword and the Warspear do.
    "id": "form.halberd",
    "name": "Halberd",
    "type": "Weapon",
    "tags": ["weapon", "halberd", "polearm"],
    "slots": {
      "head": {
        "requires_tags": ["form:metal", "form:stone", "form:crystal"],
        "mass_share": 0.45,
        "trait_expression": { "thermal": 1.0, "charge": 0.8, "toxic": 0.7, "vital": 0.2, "arcane": 0.4, "structural": 1.0 }
      },
      "haft": {
        "requires_tags": ["form:wood", "form:metal", "form:bone"],
        "mass_share": 0.45,
        "trait_expression": { "thermal": 0.3, "charge": 0.5, "toxic": 0.2, "vital": 0.6, "arcane": 0.7, "structural": 0.8 }
      },
      "langets": {
        "requires_tags": ["form:metal", "form:fiber", "form:hide"],
        "mass_share": 0.10,
        "trait_expression": { "thermal": 0.4, "charge": 0.5, "toxic": 0.3, "vital": 0.4, "arcane": 0.4, "structural": 0.7 }
      }
    },
    "stat_map": {
      "hardness":    [ { "slot": "head",    "property": "hardness",    "weight": 0.80 } ],
      "mass":        [ { "slot": "head",    "property": "mass",        "weight": 0.85 }, { "slot": "haft", "property": "mass", "weight": 0.35 } ],
      "flexibility": [ { "slot": "langets", "property": "flexibility", "weight": 0.25 } ]
    },
    "trait_cap": 4,
    "moves": ["move.hew", "move.overhead_crush"],
    "name_variants": ["Glaive", "Bardiche", "Pollaxe", "Bec de Corbin", "Bill", "Billhook", "Voulge", "Guisarme", "Fauchard", "Lochaber Axe", "Sparth Axe", "Naginata", "Guandao", "War Scythe", "Polehammer", "Swordstaff", "Scythe", "Pitchfork", "Shovel", "Shepherd's Crook"],
    "description": "An axe that decided the problem was standing too close."
  },

  {
    // Between the Dagger and the Longsword, and it earns the gap by reading BOTH hardness and
    // flexibility off the blade: short blades bend rather than break, and a brittle one snaps.
    // Carries the `sword` tag, so every sword move works on it.
    "id": "form.shortsword",
    "name": "Shortsword",
    "type": "Weapon",
    "tags": ["weapon", "sword", "shortsword", "metal"],
    "slots": {
      "blade": {
        "requires_tags": ["form:metal", "form:crystal", "form:bone"],
        "mass_share": 0.65,
        "trait_expression": { "thermal": 1.0, "charge": 0.9, "toxic": 0.9, "vital": 0.2, "arcane": 0.5, "structural": 1.0 }
      },
      "guard": {
        "requires_tags": ["form:metal", "form:bone", "form:horn"],
        "mass_share": 0.15,
        "trait_expression": { "thermal": 0.5, "charge": 0.5, "toxic": 0.3, "vital": 0.3, "arcane": 0.5, "structural": 0.8 }
      },
      "grip": {
        "requires_tags": ["form:hide", "form:leather", "form:fiber", "form:cloth"],
        "mass_share": 0.20,
        "trait_expression": { "thermal": 0.2, "charge": 0.3, "toxic": 0.5, "vital": 0.7, "arcane": 0.3, "structural": 0.3 }
      }
    },
    "stat_map": {
      "hardness":    [ { "slot": "blade", "property": "hardness",    "weight": 0.70 } ],
      "flexibility": [ { "slot": "blade", "property": "flexibility", "weight": 0.45 } ],
      "mass":        [ { "slot": "*",     "property": "mass",        "weight": 0.55 } ]
    },
    "trait_cap": 3,
    "moves": ["move.flurry", "move.iron_slash", "move.quick_stab"],
    "name_variants": ["Gladius", "Xiphos", "Wakizashi", "Katzbalger", "Butterfly Sword", "Hook Sword", "Pata", "Cleaver", "Sickle"],
    "description": "Long enough to matter, short enough to bring indoors."
  },

  {
    // Thrown, and therefore the only weapon whose mass is entirely a COST — a javelin you cannot
    // throw far is a short bad spear. Mass is read at 0.20 across the whole item, the lowest of
    // any weapon here, and the point still has to be hard.
    "id": "form.javelin",
    "name": "Javelin",
    "type": "Weapon",
    "tags": ["weapon", "javelin", "thrown", "spear"],
    "slots": {
      "point": {
        "requires_tags": ["form:metal", "form:bone", "form:horn", "form:crystal"],
        "mass_share": 0.30,
        "trait_expression": { "thermal": 0.9, "charge": 0.7, "toxic": 1.0, "vital": 0.2, "arcane": 0.4, "structural": 1.0 }
      },
      "shaft": {
        "requires_tags": ["form:wood", "form:fiber", "form:bone"],
        "mass_share": 0.55,
        "trait_expression": { "thermal": 0.3, "charge": 0.5, "toxic": 0.2, "vital": 0.6, "arcane": 0.6, "structural": 0.7 }
      },
      "fletching": {
        "requires_tags": ["form:fiber", "form:hide", "form:cloth"],
        "mass_share": 0.15,
        "trait_expression": { "thermal": 0.2, "charge": 0.3, "toxic": 0.4, "vital": 0.7, "arcane": 0.4, "structural": 0.3 }
      }
    },
    "stat_map": {
      "hardness":    [ { "slot": "point",     "property": "hardness",    "weight": 0.85 } ],
      "flexibility": [ { "slot": "shaft",     "property": "flexibility", "weight": 0.60 }, { "slot": "fletching", "property": "flexibility", "weight": 0.25 } ],
      "mass":        [ { "slot": "*",         "property": "mass",        "weight": 0.20 } ]
    },
    "trait_cap": 2,
    "moves": ["move.javelin_throw"],
    "name_variants": ["Pilum", "Plumbata", "Harpoon", "Chakram", "Shuriken", "Hunga Munga", "Mambele", "Atlatl"],
    "description": "You get one. Make the arm count."
  },

  {
    // The cheapest weapon in the game and the only one that reads NO hardness at all — a sling is
    // cord and a pouch, and what it does is decided entirely by how well the cord returns. The
    // stone is not part of the weapon, which is exactly why the poorest character can own one.
    "id": "form.sling",
    "name": "Sling",
    "type": "Weapon",
    "tags": ["weapon", "sling"],
    "slots": {
      "cord": {
        "requires_tags": ["form:fiber", "form:hide", "form:leather"],
        "mass_share": 0.60,
        "trait_expression": { "thermal": 0.2, "charge": 0.4, "toxic": 0.4, "vital": 0.8, "arcane": 0.5, "structural": 0.5 }
      },
      "cradle": {
        "requires_tags": ["form:hide", "form:leather", "form:cloth", "form:fiber"],
        "mass_share": 0.40,
        "trait_expression": { "thermal": 0.2, "charge": 0.3, "toxic": 0.5, "vital": 0.7, "arcane": 0.4, "structural": 0.4 }
      }
    },
    "stat_map": {
      "flexibility": [ { "slot": "cord",   "property": "flexibility", "weight": 1.00 }, { "slot": "cradle", "property": "flexibility", "weight": 0.35 } ],
      "mass":        [ { "slot": "*",      "property": "mass",        "weight": 0.15 } ]
    },
    "trait_cap": 2,
    "moves": ["move.sling_stone"],
    "name_variants": ["Staff Sling", "Blowgun"],
    "description": "String, leather, and whatever was lying on the ground."
  },

  {
    // Reach with no mass behind it. Flexibility off the lash at 1.35 is the hardest ANY form reads
    // flexibility off a single component — more even than the bow reads its limb. The Longbow
    // still reads more flexibility in total, and should: being the flexibility weapon is the
    // bow's identity, and the whip's is being one flexible thing on a handle.
    //
    // Hardness is read only off the handle, the part that does no damage, so a whip made of good
    // steel is a bad whip.
    "id": "form.whip",
    "name": "Whip",
    "type": "Weapon",
    "tags": ["weapon", "whip"],
    "slots": {
      "lash": {
        "requires_tags": ["form:hide", "form:leather", "form:fiber"],
        "mass_share": 0.70,
        "trait_expression": { "thermal": 0.3, "charge": 0.5, "toxic": 0.8, "vital": 0.8, "arcane": 0.5, "structural": 0.4 }
      },
      "handle": {
        "requires_tags": ["form:wood", "form:bone", "form:metal", "form:horn"],
        "mass_share": 0.30,
        "trait_expression": { "thermal": 0.4, "charge": 0.5, "toxic": 0.3, "vital": 0.5, "arcane": 0.5, "structural": 0.7 }
      }
    },
    "stat_map": {
      "flexibility": [ { "slot": "lash",   "property": "flexibility", "weight": 1.35 } ],
      "hardness":    [ { "slot": "handle", "property": "hardness",    "weight": 0.25 } ],
      "mass":        [ { "slot": "*",      "property": "mass",        "weight": 0.20 } ]
    },
    "trait_cap": 3,
    "moves": ["move.lash"],
    "name_variants": ["Urumi", "Sjambok"],
    "description": "Arrives from further away than anyone standing there expects."
  },

  {
    // Worn rather than held, and the smallest weapon in the game: mass at 0.10, and the only
    // weapon whose stat map reads nothing but hardness and mass off two tiny components. It is
    // the form for a material you have almost none of.
    "id": "form.knuckles",
    "name": "Knuckles",
    "type": "Weapon",
    "tags": ["weapon", "knuckles"],
    "slots": {
      "shell": {
        "requires_tags": ["form:metal", "form:bone", "form:horn", "form:crystal", "form:stone"],
        "mass_share": 0.70,
        "trait_expression": { "thermal": 0.9, "charge": 0.9, "toxic": 0.7, "vital": 0.3, "arcane": 0.5, "structural": 1.0 }
      },
      "wrap": {
        "requires_tags": ["form:hide", "form:leather", "form:cloth", "form:fiber"],
        "mass_share": 0.30,
        "trait_expression": { "thermal": 0.2, "charge": 0.3, "toxic": 0.5, "vital": 0.8, "arcane": 0.3, "structural": 0.3 }
      }
    },
    "stat_map": {
      "hardness": [ { "slot": "shell", "property": "hardness", "weight": 0.95 } ],
      "mass":     [ { "slot": "*",     "property": "mass",     "weight": 0.10 } ]
    },
    "trait_cap": 2,
    "moves": ["move.pummel"],
    "name_variants": ["Cestus", "Tekko", "Tekko-Kagi", "Baghnakh", "Deer Horn Knives", "Sai", "Tonfa", "War Fan", "Macuahuitl"],
    "description": "The oldest weapon there is, with an opinion added."
  },

  // ══ OFFHAND ═════════════════════════════════════════════════════════════════════════════════

  {
    "id": "form.buckler",
    "name": "Buckler",
    "type": "Offhand",
    "tags": ["armor", "shield", "parry"],
    "slots": {
      "face": {
        "requires_tags": ["form:metal", "form:wood"],
        "mass_share": 1.0,
        "trait_expression": { "thermal": 0.6, "charge": 0.4, "toxic": 0.3, "vital": 0.3, "arcane": 0.4, "structural": 1.0 },
        "identity_priority": 1
      }
    },
    "stat_map": {
      "hardness": [ { "slot": "face", "property": "hardness", "weight": 1.0 } ],
      "mass":     [ { "slot": "face", "property": "mass",     "weight": 0.8 } ]
    },
    "trait_cap": 4,
    // Identity model (Phase 3, D46/D51): all face — Toughness is the whole read. Same cap as
    // the sword's slots would give one component, so reality test 5's identical-floor rule
    // holds: the same material expresses the same identities here and on a longsword edge.
    // The lean is what makes the same material read defensively here (§12 test 5).
    "identity_cap": 2,
    "base_reads": {
      "armor": [ { "slot": "face", "stat": "toughness", "weight": 1.0 } ]
    },
    "generation_profile": { "favored_triggers": ["on_block", "on_being_struck"] },
    "description": "A small answer to large questions. Carrying one makes Shield Bash yours."
  },

  // ══ WORN ARMOUR ═════════════════════════════════════════════════════════════════════════════

  {
    // The only armour whose stat_map reads INSULATION hard, which makes it the one place a fur
    // or a felt lining out-performs a better metal. Grounding, the Storm Veil and the Insulated
    // innate are all reachable here and effectively nowhere else.
    "id": "form.helm",
    "name": "Helm",
    "type": "Head",
    "tags": ["armor", "helm"],
    "slots": {
      "crown": {
        "requires_tags": ["form:metal", "form:chitin", "form:bone", "form:horn"],
        "mass_share": 0.65,
        "trait_expression": { "thermal": 0.7, "charge": 0.5, "toxic": 0.3, "vital": 0.3, "arcane": 0.5, "structural": 1.0 }
      },
      "lining": {
        "requires_tags": ["form:hide", "form:fur", "form:cloth", "form:fiber"],
        "mass_share": 0.35,
        "trait_expression": { "thermal": 0.4, "charge": 0.3, "toxic": 0.4, "vital": 0.8, "arcane": 0.4, "structural": 0.2 }
      }
    },
    "stat_map": {
      "hardness":   [ { "slot": "crown",  "property": "hardness",   "weight": 0.55 } ],
      "mass":       [ { "slot": "*",      "property": "mass",       "weight": 0.6 } ],
      "insulation": [ { "slot": "lining", "property": "insulation", "weight": 0.9 }, { "slot": "crown", "property": "insulation", "weight": 0.2 } ]
    },
    "trait_cap": 3,
    "description": "Covers the part of you that decisions come out of."
  },

  {
    "id": "form.vest",
    "name": "Vest",
    "type": "Body",
    "tags": ["armor"],
    "slots": {
      "shell": {
        "requires_tags": ["form:hide", "form:fiber", "form:metal"],
        "mass_share": 1.0,
        "trait_expression": { "thermal": 0.5, "charge": 0.3, "toxic": 0.5, "vital": 0.8, "arcane": 0.3, "structural": 1.0 }
      }
    },
    "stat_map": {
      "hardness": [ { "slot": "shell", "property": "hardness", "weight": 0.6 }, { "slot": "shell", "property": "flexibility", "weight": 0.4 } ],
      "mass":     [ { "slot": "shell", "property": "mass",     "weight": 1.0 } ]
    },
    "trait_cap": 4,
    "description": "Worn close. The material decides whether that is comfort or armour."
  },

  {
    // Where being HARD is a cost. The stat_map reads flexibility from the glove at nearly twice
    // the weight it reads hardness from the plating, so an all-metal pair is a worse pair — the
    // opposite pressure to every other armour form, and the only reliable route to Ghoststep.
    "id": "form.gauntlets",
    "name": "Gauntlets",
    "type": "Hands",
    "tags": ["armor", "gauntlets"],
    "slots": {
      "glove": {
        "requires_tags": ["form:hide", "form:leather", "form:cloth", "form:fiber"],
        "mass_share": 0.60,
        "trait_expression": { "thermal": 0.4, "charge": 0.4, "toxic": 0.6, "vital": 0.7, "arcane": 0.5, "structural": 0.4 }
      },
      "plating": {
        "requires_tags": ["form:metal", "form:chitin", "form:bone"],
        "mass_share": 0.40,
        "trait_expression": { "thermal": 0.8, "charge": 0.6, "toxic": 0.3, "vital": 0.2, "arcane": 0.4, "structural": 1.0 }
      }
    },
    "stat_map": {
      "flexibility": [ { "slot": "glove",   "property": "flexibility", "weight": 0.95 } ],
      "hardness":    [ { "slot": "plating", "property": "hardness",    "weight": 0.35 } ],
      "mass":        [ { "slot": "*",       "property": "mass",        "weight": 0.4 } ]
    },
    "trait_cap": 3,
    "description": "The compromise every fighter argues about: protect the hand, or keep it."
  },

  {
    // Where being HEAVY is a cost, and the mirror of the Gauntlets. Hardness comes off the sole
    // and insulation off the upper, so treads reward a dense sole under a warm boot — a
    // combination no other form asks for.
    "id": "form.treads",
    "name": "Treads",
    "type": "Feet",
    "tags": ["armor", "boots"],
    "slots": {
      "sole": {
        "requires_tags": ["form:leather", "form:hide", "form:wood", "form:metal", "form:chitin"],
        "mass_share": 0.55,
        "trait_expression": { "thermal": 0.6, "charge": 0.5, "toxic": 0.4, "vital": 0.4, "arcane": 0.3, "structural": 1.0 }
      },
      "upper": {
        "requires_tags": ["form:hide", "form:fur", "form:cloth", "form:fiber"],
        "mass_share": 0.45,
        "trait_expression": { "thermal": 0.5, "charge": 0.3, "toxic": 0.5, "vital": 0.8, "arcane": 0.4, "structural": 0.3 }
      }
    },
    "stat_map": {
      "hardness":    [ { "slot": "sole",  "property": "hardness",    "weight": 0.40 } ],
      "mass":        [ { "slot": "*",     "property": "mass",        "weight": 0.7 } ],
      "flexibility": [ { "slot": "upper", "property": "flexibility", "weight": 0.5 } ],
      "insulation":  [ { "slot": "upper", "property": "insulation",  "weight": 0.6 } ]
    },
    "trait_cap": 3,
    "description": "Carry everything you own on these. Choose accordingly."
  },

  // ══ TRINKET ═════════════════════════════════════════════════════════════════════════════════

  {
    // The only form whose stat_map reads RESONANCE and ARCANE, which is what finally gives ley
    // crystal, runes and mana prisms somewhere to be excellent — a sword reads neither, so a
    // resonant material in a sword is wasted potential rather than a good sword.
    //
    // It grants no armour (Trinket is not an armour-bearing slot) and no moves. What it rolls
    // are the form-agnostic modifier families — resources, regeneration, effort — which is the
    // trinket's whole identity and needed no new affix content to express.
    "id": "form.focus",
    "name": "Focus",
    "type": "Trinket",
    "tags": ["trinket", "focus"],
    "slots": {
      "stone": {
        "requires_tags": ["form:crystal", "form:gem", "form:rune", "form:bone"],
        "mass_share": 0.70,
        "trait_expression": { "thermal": 0.6, "charge": 0.8, "toxic": 0.4, "vital": 0.6, "arcane": 1.0, "structural": 0.3 }
      },
      "setting": {
        "requires_tags": ["form:metal", "form:wood", "form:fiber"],
        "mass_share": 0.30,
        "trait_expression": { "thermal": 0.3, "charge": 0.5, "toxic": 0.2, "vital": 0.4, "arcane": 0.9, "structural": 0.4 }
      }
    },
    "stat_map": {
      "resonance": [ { "slot": "stone",   "property": "resonance", "weight": 1.0 }, { "slot": "setting", "property": "resonance", "weight": 0.3 } ],
      "arcane":    [ { "slot": "stone",   "property": "arcane",    "weight": 0.9 }, { "slot": "setting", "property": "arcane",    "weight": 0.4 } ],
      "mass":      [ { "slot": "*",       "property": "mass",      "weight": 0.3 } ]
    },
    "trait_cap": 3,
    "description": "Held, not worn. Whatever it is made of, it is listening."
  },

  // ══ RINGS ═══════════════════════════════════════════════════════════════════════════════════

  {
    // The only form that reads CONDUCTIVITY and AFFINITY. Before this form nothing in the game
    // read either, which meant the most conductive metals — silver, copper, electrum — were
    // strictly worse swords and nothing else. Same move the Focus made for resonance: a property
    // with nowhere to be excellent is a property the player has no reason to care about.
    //
    // Deliberately NOT resonance. A ring that read resonance would be a small focus, and the two
    // would compete for the same materials instead of wanting different ones.
    //
    // `type` is Ring1 because a definition must name one slot — but a ring fills EITHER position.
    // `EquipmentSlots.InterchangeablePositions` is what makes the second ring slot usable; do not
    // author a second near-identical form to fill it.
    //
    // Tiny mass share: a ring weighs nothing you would notice, so it reads mass at 0.15 and gets
    // the smallest trait_cap in the file. It is the cheapest form to make and holds the least.
    "id": "form.ring",
    "name": "Ring",
    "type": "Ring1",
    "tags": ["trinket", "ring"],
    "slots": {
      "band": {
        "requires_tags": ["form:metal", "form:bone", "form:horn"],
        "mass_share": 0.70,
        "trait_expression": { "thermal": 0.5, "charge": 1.0, "toxic": 0.3, "vital": 0.5, "arcane": 0.8, "structural": 0.4 }
      },
      "inset": {
        "requires_tags": ["form:gem", "form:crystal", "form:rune"],
        "mass_share": 0.30,
        "trait_expression": { "thermal": 0.6, "charge": 0.9, "toxic": 0.4, "vital": 0.7, "arcane": 0.9, "structural": 0.2 }
      }
    },
    "stat_map": {
      "conductivity": [ { "slot": "band",  "property": "conductivity", "weight": 1.0 }, { "slot": "inset", "property": "conductivity", "weight": 0.4 } ],
      "affinity":     [ { "slot": "inset", "property": "affinity",     "weight": 0.9 }, { "slot": "band",  "property": "affinity",     "weight": 0.3 } ],
      "mass":         [ { "slot": "*",     "property": "mass",         "weight": 0.15 } ]
    },
    "trait_cap": 2,
    "description": "Small, and worn where the hand meets everything. Twice over, if you have two."
  }
]
