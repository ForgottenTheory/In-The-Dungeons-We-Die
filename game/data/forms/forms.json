[
  // Forms — the terminal boundary where materials become equipment (identity model since
  // migration Phase 7, D54: docs/identity-foundation.md §8.1, §11.5).
  //
  // ── HOW TO READ A FORM ──────────────────────────────────────────────────────────────────────
  //
  // `slots`              named components. `requires_tags` is ANY-OF. `mass_share` is what
  //                      fraction of the item this component IS (sums to 1.0 — validated);
  //                      it weighs quality, provenance and the D51 expression tie-break.
  // `identity_priority`  which slot's identities speak first when the cap forces a choice —
  //                      authored where mass order would say the wrong thing (D51: selection
  //                      stays readable, never percentage arithmetic).
  // `identity_cap`       how many identities the finished item actively expresses; the rest
  //                      go Dormant (D51). Material capacity is a different axis on purpose.
  // `base_reads`         the D46 physical floor: which slot's Heft/Bite/Toughness/Give feeds
  //                      damage, speed and armor. Why the same iron is excellent in a
  //                      longsword's edge and a heavy stick in a spear's haft.
  // `generation_profile` the form's thumb on the sentence-generation scale (§8 stage 1) —
  //                      a shield leans toward blocking work, never a recipe.

  // ══ WEAPONS ═════════════════════════════════════════════════════════════════════════════════

  {
    "id": "form.longsword",
    "name": "Longsword",
    "type": "Weapon",
    "tags": ["weapon", "sword", "metal"],
    "slots": {
      "edge": {
        "requires_tags": ["form:metal", "form:crystal"],
        "mass_share": 0.60,
        "identity_priority": 3
      },
      "core": {
        "requires_tags": ["form:metal", "form:wood"],
        "mass_share": 0.25,
        "identity_priority": 2
      },
      "binding": {
        "requires_tags": ["form:hide", "form:fiber"],
        "mass_share": 0.15,
        "identity_priority": 1
      }
    },
    // Identity model (Phase 3, D46/D51): the blade reads Bite off the edge and swings by its
    // whole-item Heft; the edge's identities express before the core's, the core's before the
    // binding's. identity_cap 3 — a sword states at most three ideas. The generation lean is
    // §8 stage 1: a sword pushes sentences toward landing hits, never a recipe.
    "identity_cap": 3,
    "base_reads": {
      "damage": [ { "slot": "edge", "stat": "bite", "weight": 1.0 } ],
      "speed":  [ { "slot": "*",    "stat": "heft", "weight": 1.0 } ]
    },
    "generation_profile": { "favored_triggers": ["on_hit", "on_crit"] },
    "moves": ["move.iron_slash", "move.heavy_strike"],
    // Every one-handed straight or curved blade in the library. They differ by fashion and by
    // where they were made, not by what the item reads off them — so they are names, and
    // adding them cost nothing but this line.
    "name_variants": ["Arming Sword", "Broadsword", "Falchion", "Scimitar", "Sabre", "Rapier", "Estoc", "Khopesh", "Kopis", "Falcata", "Dao", "Jian", "Katana", "Tachi", "Shotel", "Kilij", "Yatagan", "Talwar", "Firangi", "Messer", "Spatha", "Shamshir", "Pulwar", "Nimcha", "Flyssa", "Takoba", "Ida", "Backsword"],
    "description": "A proper blade. The material decides what kind of proper."
  },
  {
    // The deliberate counterweight to the Longsword: the business end is a quarter of the
    // item, so where you put a material matters more than what it is.
    //
    // That is the whole material-genetics claim in one pair of forms: there is no best material,
    // only a best placement.
    "id": "form.warspear",
    "name": "Warspear",
    "type": "Weapon",
    "tags": ["weapon", "spear", "polearm"],
    "slots": {
      "point": {
        "requires_tags": ["form:metal", "form:crystal", "form:bone", "form:horn"],
        "mass_share": 0.25,
        "identity_priority": 3
      },
      "haft": {
        "requires_tags": ["form:wood", "form:metal", "form:fiber"],
        "mass_share": 0.60,
        "identity_priority": 2
      },
      "grip": {
        "requires_tags": ["form:hide", "form:fiber", "form:cloth"],
        "mass_share": 0.15,
        "identity_priority": 1
      }
    },
    // Identity model (Phase 7, D54): the point bites, the whole spear swings by its heft —
    // the placement claim survives the property model: iron in the point is excellent, iron
    // in the haft is a heavy stick.
    "identity_cap": 3,
    "base_reads": {
      "damage": [ { "slot": "point", "stat": "bite", "weight": 1.0 } ],
      "speed":  [ { "slot": "*",     "stat": "heft", "weight": 1.0 } ]
    },
    "generation_profile": { "favored_triggers": ["on_hit", "on_crit"] },
    // move.spear_thrust, not move.skewer: Skewer requires the `sword` tag, which a spear does
    // not carry, so it sat here unusable for the whole of C2a. A validator rule now catches it.
    "moves": ["move.spear_thrust", "move.quick_stab"],
    "name_variants": ["Spear", "Pike", "Lance", "Boar Spear", "Awl Pike", "Dory", "Sarissa", "Yari", "Hooked Spear", "Hunting Spear", "Trident", "Military Fork", "Ranseur", "Spetum", "Partisan", "Corseque"],
    "description": "Reach, and the discipline to use it. Most of a spear is the part nobody looks at."
  },
