[
  // Signature grammar: payloads (docs/identity-foundation.md §7.4, D50) — WHAT a sentence
  // delivers. Each entry binds to machinery that already resolves (the D30 fence, validated):
  // a registered modifier key, a shipped status, the plain damage/heal effect handlers. The
  // starter set covers the identities the Phase 2 starter materials can actually reach —
  // Dense, Vital, Ember — plus Warded's barrier, which oak's profile favors from outside its
  // open families (the §9 authored-breach path, exercised on purpose).
  //
  // `families`  which identities own it, and at which access rung (1–4). An identity of rank
  //             R opens its families' payloads of rung ≤ R.
  // `floor`     at most one per owning identity, always rung 1: the guaranteed expression the
  //             identity promises on every item that expresses it (D50 category 1). The
  //             sentence is guaranteed; a chance on it (Ember's Burn) is part of the promise.
  // `range`     [lo, hi] magnitude in mechanical units. Quality and rank position the value.
  //
  // ⚠ Every number here is provisional until play, like all identity-system numbers.

  // ---- Vital — the health pool itself --------------------------------------------------------
  {
    "id": "vitality",
    "name": "Vitality",
    "families": [ { "identity": "identity.vital", "rung": 1 } ],
    "binding": { "kind": "modifier", "key": "resource.max_health" },
    "range": [6, 14],
    "weight": 10,
    "floor": { "trigger": "while_worn", "behavior": "sustain" },
    "description": "More health, while worn — the floor every Vital item stands on."
  },
  {
    "id": "mending",
    "name": "Mending",
    "families": [ { "identity": "identity.vital", "rung": 1 } ],
    "binding": { "kind": "heal" },
    "range": [2, 5],
    "weight": 10,
    "description": "A modest heal, delivered when the sentence's trigger fires."
  },
  {
    "id": "second_wind",
    "name": "Second Wind",
    "families": [ { "identity": "identity.vital", "rung": 2 } ],
    "binding": { "kind": "heal" },
    "range": [5, 10],
    "weight": 6,
    "description": "A stronger heal — improved-rung Vital work."
  },

