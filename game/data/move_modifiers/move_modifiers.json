[
  // Move modifiers (docs/moves.md §3): match + ops, granted by components, equipment, statuses
  // or affixes (R4c-2 — worn affixes are the third grantor, through the same builder path).
  // The stormbrand example from the spec lives in the tests.

  // The Emberbrand affix's payload: heavy attacks carry heat alongside their steel — the
  // "Heavy Strike gains additional Heat damage" exemplar from the directive, as data.
  {
    "id": "movemod.emberbrand",
    "name": "Emberbrand",
    "match": { "moveId": "move.heavy_strike" },
    "ops": [
      { "op": "addAsExtra", "from": "physical", "to": "heat", "fraction": 0.25 }
    ]
  }
]
