[
  // What the three knowledge professions carry home. These are records, not power: a survey
  // chart is worth having because filing it raises Realm Knowledge, and a property dossier is
  // worth having because it is what an Assay Table consumes. Neither one ever appears in a
  // fabrication, which is the rule that keeps Cartography and Assay from quietly becoming
  // damage professions (docs/professions.md §19-20).
  //
  // Thieving's take is here too. It is deliberately *not* a currency — there is no economy yet
  // and inventing one for a breadth pass would be a fake resource. What a thief actually walks
  // away with is precious metal (already in minerals.json), a key, or somebody's paperwork.

  // --- Cartography ----------------------------------------------------------------------
  { "id": "material.charcoal_rubbing", "name": "Charcoal Rubbing", "tags": ["state:processed", "form:record", "origin:synthetic", "rarity:common", "comp:organic", "class:knowledge"], "capacity": 1 },
  { "id": "material.route_sketch", "name": "Route Sketch", "tags": ["state:processed", "form:record", "origin:synthetic", "rarity:common", "comp:organic", "class:knowledge"], "capacity": 1 },
  { "id": "material.survey_chart", "name": "Survey Chart", "tags": ["state:composite", "form:record", "origin:synthetic", "rarity:uncommon", "comp:organic", "class:knowledge"], "capacity": 2 },
  { "id": "material.hidden_way_note", "name": "Hidden Way Note", "tags": ["state:composite", "form:record", "origin:synthetic", "rarity:rare", "comp:organic", "class:knowledge"], "capacity": 2 },

  // --- Assay ----------------------------------------------------------------------------
  { "id": "material.reference_sample", "name": "Reference Sample", "tags": ["state:processed", "form:sample", "origin:synthetic", "rarity:common", "comp:inorganic", "class:knowledge"], "capacity": 1 },
  { "id": "material.property_dossier", "name": "Property Dossier", "tags": ["state:composite", "form:record", "origin:synthetic", "rarity:uncommon", "comp:organic", "class:knowledge"], "capacity": 2 },

