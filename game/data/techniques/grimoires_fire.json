[
  // Fire grimoires (spell-library expansion). One per move in spells_fire.json.
  // Deliberately in NO loot table yet — acquisition lands with the balance pass
  // (docs/spell-library.md); the debug grant button is the faucet until then.

  { "id": "technique.grimoire_ember_shot", "name": "Grimoire: Ember Shot",
    "description": "A pamphlet, singed at the corners by its own exercises.",
    "teaches": "move.ember_shot" },
  { "id": "technique.grimoire_flame_bolt", "name": "Grimoire: Flame Bolt",
    "description": "Chapter one of every fire curriculum. The margins smell of smoke.",
    "teaches": "move.flame_bolt" },
  { "id": "technique.grimoire_scorch", "name": "Grimoire: Scorch",
    "description": "The author recommends patience. The spell is the patient kind of fire.",
    "teaches": "move.scorch" },
  { "id": "technique.grimoire_ignite", "name": "Grimoire: Ignite",
    "description": "One page. One word. The rest is aftermath.",
    "teaches": "move.ignite" },
  { "id": "technique.grimoire_smolder", "name": "Grimoire: Smolder",
    "description": "Bound in leather that is always slightly warm.",
    "teaches": "move.smolder" },
  { "id": "technique.grimoire_searing_ray", "name": "Grimoire: Searing Ray",
    "description": "A treatise on straight lines, by someone who hated corners.",
    "teaches": "move.searing_ray" },
  { "id": "technique.grimoire_fire_lance", "name": "Grimoire: Fire Lance",
    "description": "Fireball, revised by a fencing instructor.",
    "teaches": "move.fire_lance" },
  { "id": "technique.grimoire_flame_whip", "name": "Grimoire: Flame Whip",
    "description": "The diagrams move if you watch them too long.",
    "teaches": "move.flame_whip" },
  { "id": "technique.grimoire_burning_hands", "name": "Grimoire: Burning Hands",
    "description": "Practical, close-range, and hard on the sleeves.",
    "teaches": "move.burning_hands" },
  { "id": "technique.grimoire_blazing_orb", "name": "Grimoire: Blazing Orb",
    "description": "Instructions for carrying a small sun without apologising to it.",
    "teaches": "move.blazing_orb" },
  { "id": "technique.grimoire_combustion", "name": "Grimoire: Combustion",
    "description": "A proof, in the mathematical sense. The target is the demonstration.",
    "teaches": "move.combustion" },
  { "id": "technique.grimoire_molten_spear", "name": "Grimoire: Molten Spear",
    "description": "Smithing notes that gave up on the anvil halfway through.",
    "teaches": "move.molten_spear" },
  { "id": "technique.grimoire_cinder_blast", "name": "Grimoire: Cinder Blast",
    "description": "On the reuse of spent fires. Thrifty and unkind.",
    "teaches": "move.cinder_blast" },
  { "id": "technique.grimoire_magma_burst", "name": "Grimoire: Magma Burst",
    "description": "Field notes from the edge of a caldera, in a very steady hand.",
    "teaches": "move.magma_burst" },
  { "id": "technique.grimoire_flame_burst", "name": "Grimoire: Flame Burst",
    "description": "Fire, hurried. The binding never quite cooled.",
    "teaches": "move.flame_burst" },
  { "id": "technique.grimoire_flame_wave", "name": "Grimoire: Flame Wave",
    "description": "Tidal charts, annotated by an arsonist.",
    "teaches": "move.flame_wave" },
  { "id": "technique.grimoire_ring_of_fire", "name": "Grimoire: Ring of Fire",
    "description": "For the caster who is tired of choosing a direction.",
    "teaches": "move.ring_of_fire" },
  { "id": "technique.grimoire_ember_rain", "name": "Grimoire: Ember Rain",
    "description": "A weather almanac with strong opinions about what weather should be.",
    "teaches": "move.ember_rain" },
  { "id": "technique.grimoire_ash_cloud", "name": "Grimoire: Ash Cloud",
    "description": "On what fire leaves behind, and what to do with it.",
    "teaches": "move.ash_cloud" },
  { "id": "technique.grimoire_cinderstorm", "name": "Grimoire: Cinderstorm",
    "description": "Every coal remembers. This book reminds them.",
    "teaches": "move.cinderstorm" },
  { "id": "technique.grimoire_firestorm", "name": "Grimoire: Firestorm",
    "description": "The chapter headings are scorch marks. It reads fine anyway.",
    "teaches": "move.firestorm" },
  { "id": "technique.grimoire_lava_wave", "name": "Grimoire: Lava Wave",
    "description": "Geology, radicalised.",
    "teaches": "move.lava_wave" },
  { "id": "technique.grimoire_volcanic_eruption", "name": "Grimoire: Volcanic Eruption",
    "description": "The last chapter is just an illustration. It is enough.",
    "teaches": "move.volcanic_eruption" },
  { "id": "technique.grimoire_inferno", "name": "Grimoire: Inferno",
    "description": "Kept in a lead box, for the box's sake.",
    "teaches": "move.inferno" },
  { "id": "technique.grimoire_flame_shield", "name": "Grimoire: Flame Shield",
    "description": "Defensive fire theory, by a survivor of offensive fire theory.",
    "teaches": "move.flame_shield" },
  { "id": "technique.grimoire_heat_ward", "name": "Grimoire: Heat Ward",
    "description": "How to be politely declined by a furnace.",
    "teaches": "move.heat_ward" }
]
