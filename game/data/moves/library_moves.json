[
  // The universal move library (M2′b, DECISIONS D25). Every move here is learnable by any
  // build via its technique item — gates are costs, equipped tags and cooldowns, never class.
  // Numbers are conservative placeholders, tuned relative to each other; absolute tuning
  // happens at the deferred balance pass (GDD §18 #16 note: spells author plain windups).

  // ---- Martial techniques (stamina) --------------------------------------------------------
  {
    "id": "move.sunder", "name": "Sunder",
    "kind": "Attack",
    "tags": ["action:attack", "delivery:melee", "form:sword", "mech:impairment"],
    "timing": { "telegraphTicks": 3, "windupTicks": 9, "recoveryTicks": 16 },
    "costs": [ { "resource": "stamina", "amount": 10 } ],
    "requires": [ { "kind": "equippedTag", "text": "sword" } ],
    "packets": [ { "type": "Crushing", "amount": 14 } ],
